<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Windows 蓝浅色主题 Token（设计文档 06§5：Dark/Light 切换后所有页面和弹层都正常）。
    key 与 Theme.Dark.xaml 完全一致；主色仍是 Windows 蓝，不引入第二主色。
    浅色下状态色需要加深，否则 #FCE100 一类在浅底上不可读。
  -->

  <Color x:Key="SystemAccentColor">#0078D4</Color>
  <Color x:Key="SystemAccentColorPrimary">#0078D4</Color>
  <Color x:Key="SystemAccentColorSecondary">#0063B1</Color>
  <Color x:Key="SystemAccentColorTertiary">#2899F5</Color>

  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B30078D4" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#800078D4" />
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="SystemControlHighlightAccent2Brush" Color="#CC0078D4" />
  <!-- 导航选中底：浅底上用淡蓝，保证深色文字可读 -->
  <SolidColorBrush x:Key="SystemControlHighlightAccent3Brush" Color="#FFDCE9F7" />

  <!-- 轻强调（浅色下用更深的蓝，保证在浅底上的对比度） -->
  <SolidColorBrush x:Key="AccentLightBrush" Color="#0067C0" />

  <!-- 状态色（浅色主题加深版本） -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="InfoBrush" Color="#0F548C" />

  <SolidColorBrush x:Key="TrendUpBrush" Color="#0F7B0F" />
  <SolidColorBrush x:Key="TrendDownBrush" Color="#C42B1C" />

  <!-- 浅色背景：主背景 #F3F3F3、导航 #EBEBEB、卡片 #FFFFFF、控件 #FFFFFF、描边 #D6D6D6 -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#EBEBEB" />
  <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EBEBEB" />
  <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F6F6F6" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E5E5E5" />
  <SolidColorBrush x:Key="StrokeFillColorDefaultBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C5C5C" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A8A8A" />

  <!-- Banner：浅色下用淡蓝灰，避免深底配深色文字的不可读组合 -->
  <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#EAF2FB" />
</ResourceDictionary>
