<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- Shared presentation only: retain the existing commands and view models. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ItemTextBrush}" />
    <Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border x:Name="Focus" Margin="1" BorderThickness="2" CornerRadius="6" BorderBrush="Transparent" />
          <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="2"
                  Background="{DynamicResource ControlSurfaceBrush}" BorderBrush="{DynamicResource SecondaryTextBrush}">
            <Grid>
              <Path x:Name="Tick" Data="M 1 6 L 5 10 L 13 1" Width="13" Height="10" Stretch="Fill"
                    Stroke="{DynamicResource PrimaryForegroundBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              <Border x:Name="Mixed" Width="10" Height="2" Background="{DynamicResource PrimaryForegroundBrush}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" /></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="IsChecked" Value="{x:Null}">
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
            <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledTextBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ui:Snackbar" BasedOn="{StaticResource {x:Type ui:Snackbar}}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ui:Snackbar">
        <Border Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <ui:SymbolIcon x:Name="StatusIcon" Symbol="Info24" FontSize="20" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1" Margin="8,0,10,0">
              <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ItemTextBrush}" TextWrapping="Wrap" />
              <ContentPresenter Content="{TemplateBinding Content}" Margin="0,4,0,0" TextElement.Foreground="{DynamicResource SecondaryTextBrush}">
                <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="13" /></Style></ContentPresenter.Resources>
              </ContentPresenter>
            </StackPanel>
            <ui:Button Grid.Column="2" Content="×" Appearance="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" Command="{TemplateBinding TemplateButtonCommand}" Padding="0" Width="28" MinHeight="28" Height="28" VerticalAlignment="Top" ToolTip="关闭提示" AutomationProperties.Name="关闭通知" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Appearance" Value="Success"><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Setter TargetName="StatusIcon" Property="Symbol" Value="CheckmarkCircle24" /></Trigger>
          <Trigger Property="Appearance" Value="Caution"><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource WarningBrush}" /><Setter TargetName="StatusIcon" Property="Symbol" Value="Warning24" /></Trigger>
          <Trigger Property="Appearance" Value="Danger"><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter TargetName="StatusIcon" Property="Symbol" Value="ErrorCircle24" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsShown" Value="True"><Setter Property="Visibility" Value="Visible" /></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource ItemTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ItemTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ItemSelectedBackgroundBrush}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Margin" Value="6,3" />
  </Style>
  <Style x:Key="ProjectTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource ItemTextBrush}" />
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="MinWidth" Value="136" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Surface" Background="{DynamicResource CardSurfaceBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" CornerRadius="6,6,0,0">
            <Grid>
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                VerticalAlignment="Center" RecognizesAccessKey="True" />
              <Border x:Name="Indicator" Height="3" VerticalAlignment="Bottom" Margin="-24,0,-24,-12"
                      Background="{DynamicResource FocusRingBrush}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ItemHoverBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ItemSelectedBackgroundBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource ItemSelectedForegroundBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem" BasedOn="{StaticResource ProjectTabItem}" />
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,16,0,0" ContentSource="SelectedContent"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
