<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Windows 蓝深色主题 Token（设计文档 00§5）。
    AccentStrong #0078D4 主按钮、Accent #60CDFF 轻强调；硬性禁用紫色主色与紫色渐变。
    与 Theme.Light.xaml 必须保持同一批 key，缺 key 会导致切换主题后控件回退到 WPF-UI 默认色。
  -->

  <Color x:Key="SystemAccentColor">#0078D4</Color>
  <Color x:Key="SystemAccentColorPrimary">#0078D4</Color>
  <Color x:Key="SystemAccentColorSecondary">#0063B1</Color>
  <Color x:Key="SystemAccentColorTertiary">#2899F5</Color>

  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B30078D4" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#800078D4" />
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="SystemControlHighlightAccent2Brush" Color="#174B72" />
  <!-- 导航选中底：低饱和蓝（设计文档 00§3 建议 #163A55 一类） -->
  <SolidColorBrush x:Key="SystemControlHighlightAccent3Brush" Color="#AA163A55" />

  <!-- 导航选中态：概念图为蓝色实底；浅色用淡蓝保证深色文字可读 -->
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#174B72" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="#174B72" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#60CDFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2C3642" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#252D37" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F3F4F6" />
  <!-- 轻强调（焦点/链接） -->
  <SolidColorBrush x:Key="AccentLightBrush" Color="#60CDFF" />

  <SolidColorBrush x:Key="PillSuccessBackgroundBrush" Color="#1B3324" />
  <SolidColorBrush x:Key="PillSuccessBorderBrush" Color="#2E6B43" />
  <SolidColorBrush x:Key="PillModifyBackgroundBrush" Color="#1B2D44" />
  <SolidColorBrush x:Key="PillModifyBorderBrush" Color="#2F5F93" />
  <SolidColorBrush x:Key="PillDangerBackgroundBrush" Color="#3A1F1F" />
  <SolidColorBrush x:Key="PillDangerBorderBrush" Color="#7A3535" />
  <!-- 状态色 -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
  <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />

  <!-- 趋势色（统计卡涨跌）：绿涨红跌 -->
  <SolidColorBrush x:Key="TrendUpBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="TrendDownBrush" Color="#FF6B6B" />

  <!-- 深色背景：主背景 #202020、导航 #1C1C1C、卡片 #2B2B2B、控件 #1F1F1F、描边 #454545 -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1D232A" />
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1D232A" />
  <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#171C22" />
  <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#171C22" />
  <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#1D232A" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#20272F" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#252D37" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#252D37" />
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2C3642" />
  <SolidColorBrush x:Key="StrokeFillColorDefaultBrush" Color="#3E4A58" />
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F3F4F6" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B4BFCC" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8895A4" />

  <!-- 欢迎 Banner 底色（设计文档 01§3.2：#252B30 同色系层次，不用渐变） -->
  <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#20272F" />

  <!-- 设计文档 00§8 项目语义键：页面样式只引用这些键 -->
  <SolidColorBrush x:Key="NavSurfaceBrush" Color="#171C22" />
  <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#1D232A" />
  <SolidColorBrush x:Key="ReadingSurfaceBrush" Color="#20272F" />
  <SolidColorBrush x:Key="CardSurfaceBrush" Color="#20272F" />
  <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#252D37" />
  <SolidColorBrush x:Key="StrokeBrush" Color="#3E4A58" />
  <SolidColorBrush x:Key="ItemTextBrush" Color="#F3F4F6" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B4BFCC" />
  <SolidColorBrush x:Key="ItemHoverBackgroundBrush" Color="#2C3642" />
  <SolidColorBrush x:Key="ItemSelectedBackgroundBrush" Color="#174B72" />
  <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ItemSelectedBorderBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="PrimaryHoverBackgroundBrush" Color="#006FC2" />
  <SolidColorBrush x:Key="PrimaryPressedBackgroundBrush" Color="#005A9E" />
  <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#AAB4C0" />
  <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#303A47" />

  <!-- 决策框遮罩（00§9.2）：深色黑色42% -->
  <SolidColorBrush x:Key="OverlayBrush" Color="#6B000000" />

  <SolidColorBrush x:Key="AccentButtonBackground" Color="#0078D4" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#006FC2" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#005A9E" />
  <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#AAB4C0" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#303A47" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#303A47" />
</ResourceDictionary>
