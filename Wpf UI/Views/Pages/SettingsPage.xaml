<Page
  x:Class="LLM_Wiki.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:helpers="clr-namespace:LLM_Wiki.Helpers"
  Title="SettingsPage"
  d:DataContext="{d:DesignInstance local:SettingsPage, IsDesignTimeCreatable=False}"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <helpers:InverseBoolConverter x:Key="InverseBool" />
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="900">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ 标题 ============ -->
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Style="{StaticResource PageTitleText}" Text="设置" />
        <TextBlock
          Margin="0,-8,0,0"
          Text="应用外观与版本信息。"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      </StackPanel>

      <!-- ============ 外观 ============ -->
      <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitleText}" Text="外观" />
          <TextBlock
            Margin="0,-6,0,10"
            FontSize="{StaticResource FontSizeCaption}"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="切换后立即生效，并记住到下次启动。" />

          <StackPanel Orientation="Horizontal">
            <RadioButton
              Margin="0,0,24,0"
              Content="深色（默认）"
              GroupName="themeSelect"
              Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
              CommandParameter="dark"
              IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
            <RadioButton
              Content="浅色"
              GroupName="themeSelect"
              Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
              CommandParameter="light"
              IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ 版本与更新 ============ -->
      <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitleText}" Text="版本与更新" />

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="当前版本：" />
            <TextBlock
              Grid.Column="1"
              Margin="4,0,0,0"
              VerticalAlignment="Center"
              FontFamily="Consolas"
              Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
          </Grid>

          <StackPanel Orientation="Horizontal">
            <ui:Button
              Appearance="Primary"
              Content="检查更新"
              Icon="ArrowSync24"
              Margin="0,0,8,0"
              IsEnabled="{Binding ViewModel.IsCheckingUpdate, Converter={StaticResource InverseBool}}"
              Command="{Binding ViewModel.CheckUpdateCommand}" />
            <ui:Button
              Appearance="Secondary"
              Content="打开下载页"
              Icon="Open24"
              Command="{Binding ViewModel.OpenDownloadPageCommand}"
              Visibility="{Binding ViewModel.HasUpdate, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <TextBlock
            Margin="0,8,0,0"
            FontSize="{StaticResource FontSizeCaption}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="{Binding ViewModel.UpdateStatus}" />
        </StackPanel>
      </Border>

      <!-- ============ 说明 ============ -->
      <Border Grid.Row="3" Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitleText}" Text="关于" />
          <TextBlock
            TextWrapping="Wrap"
            FontSize="{StaticResource FontSizeCaption}"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="LLM Wiki 桌面版：把分散资料整理为可持续维护的本地知识库，配合 AI Agent 完成 Ingest、查询与维护。数据保存在本机存储目录中。" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
