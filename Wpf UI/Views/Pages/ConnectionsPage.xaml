<Page xmlns:local="clr-namespace:LLM_Wiki.Views.Pages" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LLM_Wiki.Views.Pages.ConnectionsPage" Title="连接与分享" d:DataContext="{d:DesignInstance local:ConnectionsPage, IsDesignTimeCreatable=False}" d:DesignHeight="760" d:DesignWidth="1100" ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}" ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" mc:Ignorable="d">
  <Page.Resources>
    <dialogs:ConfirmationDialog x:Key="ConfirmDlg" />
  </Page.Resources>
  <Grid Margin="{StaticResource PageContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="连接与分享" />
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="浏览分享与 AI 工具各自独立启停；服务范围绑定启动时的知识库。" />
    </StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding ViewModel.ActiveTab, Mode=TwoWay}">
      <TabItem Header="浏览分享" AutomationProperties.Name="浏览分享页签">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Border Padding="16" CornerRadius="10" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ViewModel.ShareStatus}" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.ShareLibraryText}" />
                <Grid Margin="0,10,0,0" Visibility="{Binding ViewModel.ShareError, Converter={StaticResource StringToVisibility}}">
                  <ui:InfoBar IsOpen="True" IsClosable="False" Title="浏览分享启动失败" Message="{Binding ViewModel.ShareError, Mode=OneWay}" Severity="Error" />
                </Grid>
                <Grid Margin="0,12,0,0" Visibility="{Binding ViewModel.ShareBoundElsewhere, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:InfoBar Grid.Column="0" IsOpen="{Binding ViewModel.ShareBoundElsewhere, Mode=OneWay}" IsClosable="False" Title="正在分享的库与当前知识库不同" Message="切换当前库不会更换分享范围；如需更换，请停止并重新开始。" Severity="Warning" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Content="停止并更换分享范围" ToolTipService.ToolTip="先停止当前浏览分享，再把分享范围改为当前知识库（会生成新访问码）" AutomationProperties.Name="停止并更换分享范围" Command="{Binding ViewModel.ReplaceShareRangeCommand}" />
                </Grid>
                <Grid Margin="0,14,0,0" Visibility="{Binding ViewModel.ShareRunning, Converter={StaticResource InvBoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="端口" />
                  <ui:NumberBox Grid.Column="1" Width="140" HorizontalAlignment="Left" Minimum="0" Maximum="65535" Value="{Binding ViewModel.SharePortInput, Mode=TwoWay}" ToolTipService.ToolTip="浏览分享监听端口：0-65535，0 表示由系统分配空闲端口" AutomationProperties.Name="浏览分享端口" />
                  <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.SharePortHint}" />
                </Grid>
                <TextBlock Margin="110,2,0,0" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource DangerBrush}" Text="{Binding ViewModel.SharePortError}" Visibility="{Binding ViewModel.SharePortError, Converter={StaticResource StringToVisibility}}" />
                <Grid Margin="0,10,0,0" Visibility="{Binding ViewModel.ShareRunning, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="实际端口" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding ViewModel.SharePortHint}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <ui:Button Content="启动浏览分享" Appearance="Primary" Command="{Binding ViewModel.StartShareCommand}" Visibility="{Binding ViewModel.ShareRunning, Converter={StaticResource InvBoolToVis}}" Margin="0,0,8,0" ToolTipService.ToolTip="以当前知识库为范围开启只读浏览服务（按端口输入启动）" AutomationProperties.Name="启动浏览分享" />
                  <ui:Button Content="停止浏览分享" Command="{Binding ViewModel.StopShareCommand}" Visibility="{Binding ViewModel.ShareRunning, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" ToolTipService.ToolTip="停止浏览分享，旧访问码与已认证会话立即失效" AutomationProperties.Name="停止浏览分享" />
                  <ui:Button Content="打开地址" Command="{Binding ViewModel.OpenShareAddressCommand}" Visibility="{Binding ViewModel.ShareRunning, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="在系统浏览器中打开本机访问地址" AutomationProperties.Name="打开分享地址" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Visibility="{Binding ViewModel.ShareRunning, Converter={StaticResource BoolToVis}}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="访问地址" />
                  <TextBox Grid.Column="1" IsReadOnly="True" AutomationProperties.Name="浏览分享访问地址" Text="{Binding ViewModel.ShareAddress}" />
                  <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="复制" Command="{Binding ViewModel.CopyShareAddressCommand}" ToolTipService.ToolTip="复制不含访问码的访问地址" AutomationProperties.Name="复制访问地址" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="访问码" />
                  <TextBox Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="18" AutomationProperties.Name="浏览分享访问码" Text="{Binding ViewModel.Pin}" />
                  <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="复制" Command="{Binding ViewModel.CopyPinCommand}" ToolTipService.ToolTip="复制 4 位访问码（不会进入通知摘要或日志）" AutomationProperties.Name="复制访问码" />
                  <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="更换访问码" Command="{Binding ViewModel.RegeneratePinCommand}" ToolTipService.ToolTip="更换访问码：旧访问码和已认证浏览会话立即失效" AutomationProperties.Name="更换访问码" />
                </Grid>
                <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="允许：浏览、预览、下载。   不允许：上传、编辑、删除、修改配置。   二维码默认不含访问码；请单独告知访问码。" />
              </Grid>
            </Border>
            <Border Margin="0,10,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Visibility="{Binding ViewModel.ShareRunning, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="局域网地址" />
                <ItemsControl ItemsSource="{Binding ViewModel.LanAddresses}" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,2" FontFamily="Consolas" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="没有局域网地址时，可先用本机地址测试；多个网卡会逐条列出。" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="AI 工具" AutomationProperties.Name="AI 工具页签">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Border Padding="16" CornerRadius="10" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="本机执行工具" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.AgentIntegrationHint}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.AgentReadyText}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding ViewModel.IsWorkBuddyTool, Converter={StaticResource BoolToVis}}">
                  <ui:Button Content="打开 WorkBuddy" Command="{Binding ViewModel.OpenWorkBuddyCommand}" Margin="0,0,8,0" />
                  <ui:Button Content="复制 MCP 连接配置" Command="{Binding ViewModel.CopyMcpConfigCommand}" />
                  <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="在 WorkBuddy 添加 MCP；整理页复制任务，在桌面执行后返回核对。" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Padding="14" CornerRadius="8" Background="{DynamicResource ControlSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ViewModel.AgentConfigTitle}" Margin="0,0,0,10" />
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="工具类型" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ViewModel.AgentToolTypes}" SelectedItem="{Binding ViewModel.SelectedAgentTool, Mode=TwoWay}" IsEnabled="{Binding ViewModel.AgentBusy, Converter={StaticResource InverseBool}}" AutomationProperties.Name="本机工具类型" />
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="程序路径" />
                        <ui:TextBox Grid.Column="1" Text="{Binding ViewModel.AgentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding ViewModel.AgentPathHint}" AutomationProperties.Name="本机工具程序路径" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="自动查找" Command="{Binding ViewModel.AutoFindAgentCommand}" ToolTipService.ToolTip="查找所选工具；结果先展示，确认后应用" AutomationProperties.Name="自动查找 Codex CLI" />
                        <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="浏览" Command="{Binding ViewModel.BrowseAgentPathCommand}" ToolTipService.ToolTip="选择本机 codex.exe 绝对路径" AutomationProperties.Name="浏览选择 Codex CLI 程序" />
                      </Grid>
                      <Border Margin="0,0,0,8" Padding="10" CornerRadius="6" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Visibility="{Binding ViewModel.HasAgentCandidate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="自动查找候选（尚未应用）" />
                          <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Text="{Binding ViewModel.AgentPendingPath}" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:Button Content="应用此路径" Appearance="Primary" Command="{Binding ViewModel.ApplyAgentCandidateCommand}" ToolTipService.ToolTip="将候选路径写入程序路径并重置验证状态" AutomationProperties.Name="应用候选路径" />
                            <ui:Button Margin="8,0,0,0" Content="放弃" Command="{Binding ViewModel.DismissAgentCandidateCommand}" ToolTipService.ToolTip="忽略该候选路径" AutomationProperties.Name="放弃候选路径" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="运行环境" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Windows 原生" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="模型" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="使用外部工具已有配置" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="文件访问" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ViewModel.AgentAccessText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </Grid>
                      <StackPanel Margin="0,2,0,10" Visibility="{Binding ViewModel.IsCliTool, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="权限" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Content="只读" IsChecked="{Binding ViewModel.AgentAllowWrite, Converter={StaticResource InverseBool}, Mode=OneWay}" Click="OnAgentReadOnlyClick" Margin="0,0,18,0" />
                          <RadioButton Content="允许当前库目录写操作" IsChecked="{Binding ViewModel.AgentAllowWrite, Mode=OneWay}" Click="OnAgentWriteClick" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="文件访问权限由操作系统和外部工具共同约束，不能强制仅限 wiki/。" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{Binding ViewModel.AgentDetectText}" Command="{Binding ViewModel.DetectAgentCommand}" ToolTipService.ToolTip="运行所选程序的 --version 与 exec --help，并查询外部登录状态" AutomationProperties.Name="检测安装与登录" Margin="0,0,8,0" />
                        <ui:Button Content="验证实际执行" Visibility="{Binding ViewModel.IsCliTool, Converter={StaticResource BoolToVis}}" Command="{Binding ViewModel.ProbeAgentCommand}" ToolTipService.ToolTip="在隔离临时目录做真实非交互测试；会使用已有账号和额度" AutomationProperties.Name="验证实际执行" Margin="0,0,8,0" />
                        <ui:Button Content="保存并使用" Appearance="Primary" Command="{Binding ViewModel.SaveAgentCommand}" ToolTipService.ToolTip="保存配置；只有所需能力实际通过才成为本机就绪" AutomationProperties.Name="保存并使用本机工具配置" />
                      </StackPanel>
                      <TextBlock Margin="0,6,0,0" Text="{Binding ViewModel.AgentError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.AgentVersion, StringFormat='版本：{0}'}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="{DynamicResource ControlSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock FontSize="16" FontWeight="SemiBold" Text="检测与能力" Margin="0,0,0,8" />
                      <ItemsControl ItemsSource="{Binding ViewModel.AgentChecks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,4">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="●" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsOk}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Margin="0,8,0,4" Text="格式能力（独立验证，TXT 通过不代表其他格式已实测）" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                      <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="格式" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="状态" Margin="12,0,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Grid.Column="2" Text="最近验证" Margin="16,0,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding ViewModel.AgentFormats}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="{Binding Format}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail, Mode=OneWay}" />
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="12,0,0,0" ToolTip="{Binding Detail, Mode=OneWay}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Status}" Value="已验证">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <TextBlock Grid.Column="2" Text="{Binding LastVerified}" Margin="16,0,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel.AgentStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="查看登录与使用说明" Command="{Binding ViewModel.OpenCodexHelpCommand}" ToolTipService.ToolTip="登录在 Codex 自己的界面完成，本应用不读取认证文件" AutomationProperties.Name="查看 Codex 登录说明" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
            <ui:CardExpander Margin="0,10,0,0" Padding="16" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Header="手动使用说明" IsExpanded="False">
              <StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="到整理页复制完整任务，在能访问该目录的外部 AI 中执行。库身份、规则入口、范围和边界已自动组合，不需要先单独复制接入说明。" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <ui:Button Content="查看库说明" Command="{Binding ViewModel.ToggleBoundaryCommand}" Margin="0,0,8,0" ToolTipService.ToolTip="展开或折叠当前库的目标与边界说明" AutomationProperties.Name="查看库说明" />
                  <ui:Button Content="复制库说明" Command="{Binding ViewModel.CopyBoundaryCommand}" ToolTipService.ToolTip="复制完整库说明，便于粘贴到外部 AI" AutomationProperties.Name="复制库说明" />
                </StackPanel>
                <TextBox Margin="0,10,0,0" MaxHeight="220" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}" Text="{Binding ViewModel.BoundaryPrompt}" Visibility="{Binding ViewModel.BoundaryVisible, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </ui:CardExpander>
            <ui:CardExpander Margin="0,10,0,0" Padding="16" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Header="MCP 连接" IsExpanded="False">
              <StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.McpStatusHint}" />
                <Grid Margin="0,8,0,0" Visibility="{Binding ViewModel.McpError, Converter={StaticResource StringToVisibility}}">
                  <ui:InfoBar IsOpen="True" IsClosable="False" Title="MCP 服务错误" Message="{Binding ViewModel.McpError, Mode=OneWay}" Severity="Error" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <ui:Button Content="开启只读连接" Appearance="Primary" Command="{Binding ViewModel.StartMcpReadOnlyCommand}" Visibility="{Binding ViewModel.McpRunning, Converter={StaticResource InvBoolToVis}}" Margin="0,0,8,0" ToolTipService.ToolTip="以当前知识库为授权库启动 MCP HTTP 服务（默认只读、仅本机回环）" AutomationProperties.Name="开启 MCP 只读连接" />
                  <ui:Button Content="关闭 MCP 连接" Command="{Binding ViewModel.StopMcpCommand}" Visibility="{Binding ViewModel.McpRunning, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" ToolTipService.ToolTip="停止 MCP 服务，所有使用旧令牌的连接失效" AutomationProperties.Name="关闭 MCP 连接" />
                  <ui:Button Content="停止并更换绑定库" Command="{Binding ViewModel.ReplaceMcpRangeCommand}" Visibility="{Binding ViewModel.McpBoundElsewhere, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" ToolTipService.ToolTip="停止当前 MCP 服务并以当前知识库重启（需确认）" AutomationProperties.Name="停止并更换 MCP 绑定库" />
                  <ui:Button Content="{Binding ViewModel.McpWriteButtonText}" Command="{Binding ViewModel.ToggleMcpWriteCommand}" Visibility="{Binding ViewModel.McpRunning, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="在只读与写入档之间切换；开启写入需要一次明确确认" AutomationProperties.Name="切换 MCP 写入档" />
                  <ui:ProgressRing Width="18" Height="18" Margin="8,0,0,0" IsIndeterminate="True" Visibility="{Binding ViewModel.McpBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Visibility="{Binding ViewModel.McpRunning, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="状态" />
                    <TextBlock Grid.Column="1" Text="{Binding ViewModel.McpStatus}" />
                  </Grid>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="本机端点" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{Binding ViewModel.McpEndpoint}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,4">
                    <ui:Button Content="切换局域网监听" Command="{Binding ViewModel.ToggleMcpLanCommand}" ToolTipService.ToolTip="开启或关闭局域网监听；开启需确认，仅限可信网络，客户端仍需令牌" AutomationProperties.Name="切换 MCP 局域网监听" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.McpLanText}" />
                  </StackPanel>
                  <StackPanel Margin="0,4" Visibility="{Binding ViewModel.McpLanEndpoints.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="局域网地址（客户端连接以下地址，仍需携带令牌）" />
                    <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding ViewModel.McpLanEndpoints}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Margin="0,1" FontFamily="Consolas" Text="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="写入仅限本库 wiki/ 下的文本文件；禁止资料、规则、日志和删除。重启应用后恢复只读。" />
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.McpStatusHint}" />
                  <Expander Margin="0,8,0,0" Header="最近受控调用" IsExpanded="True" Visibility="{Binding ViewModel.RecentCalls.Count, Converter={StaticResource CountToVis}}">
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ViewModel.RecentCalls}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Margin="0,1" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="{Binding TimeText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Tool, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding StatusText, Mode=OneWay}" />
                          </TextBlock>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>
                <StackPanel Margin="0,12,0,0">
                  <TextBlock FontWeight="SemiBold" Text="访问令牌（受保护存储；不进入普通配置、任务或日志）" />
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="读取令牌" />
                    <TextBox Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="读取令牌" Text="{Binding ViewModel.McpReadTokenDisplay}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="复制" IsEnabled="{Binding ViewModel.McpRunning}" Command="{Binding ViewModel.CopyReadTokenCommand}" ToolTipService.ToolTip="复制读取令牌（通知只提示已复制，不回显内容）" AutomationProperties.Name="复制读取令牌" />
                    <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="重新生成" IsEnabled="{Binding ViewModel.McpRunning}" Command="{Binding ViewModel.RegenerateReadTokenCommand}" ToolTipService.ToolTip="重新生成读取令牌，旧读取令牌立即失效" AutomationProperties.Name="重新生成读取令牌" />
                  </Grid>
                  <Grid Margin="0,4" Visibility="{Binding ViewModel.McpWriteEnabled, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="写入令牌" />
                    <TextBox Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="写入令牌" Text="{Binding ViewModel.McpWriteTokenDisplay}" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="复制" IsEnabled="{Binding ViewModel.McpRunning}" Command="{Binding ViewModel.CopyWriteTokenCommand}" ToolTipService.ToolTip="复制写入令牌（通知只提示已复制，不回显内容）" AutomationProperties.Name="复制写入令牌" />
                    <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="重新生成" IsEnabled="{Binding ViewModel.McpRunning}" Command="{Binding ViewModel.RegenerateWriteTokenCommand}" ToolTipService.ToolTip="重新生成写入令牌，旧写入令牌立即失效" AutomationProperties.Name="重新生成写入令牌" />
                  </Grid>
                  <ui:Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="{Binding ViewModel.TokenVisibilityText}" IsEnabled="{Binding ViewModel.McpRunning}" Command="{Binding ViewModel.ToggleTokensCommand}" ToolTipService.ToolTip="在掩码与明文之间切换令牌显示" AutomationProperties.Name="显示或隐藏令牌" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="客户端配置（HTTP remote + stdio）" />
                <TextBox MaxHeight="200" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}" Text="{Binding ViewModel.McpClientConfigDisplay, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <ui:Button Content="复制客户端配置" Command="{Binding ViewModel.CopyMcpConfigCommand}" Margin="0,0,8,0" ToolTipService.ToolTip="复制客户端 JSON 配置（令牌已掩码，复制的是原文）" AutomationProperties.Name="复制 MCP 客户端配置" />
                  <ui:Button Content="{Binding ViewModel.TokenVisibilityText}" IsEnabled="{Binding ViewModel.McpRunning}" Command="{Binding ViewModel.ToggleTokensCommand}" ToolTipService.ToolTip="在掩码与明文之间切换令牌显示" AutomationProperties.Name="显示或隐藏客户端配置中的令牌" />
                </StackPanel>
              </StackPanel>
            </ui:CardExpander>
            <ui:CardExpander Margin="0,10,0,0" Padding="16" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Header="高级：stdio 本机进程" IsExpanded="False">
              <StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="由外部客户端启动，退出桌面应用不一定停止该进程。首轮只读；授权库通过启动参数 --kb 指定，改配置后需重启客户端进程。" />
                <TextBlock Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding ViewModel.McpClientConfigDisplay, Mode=OneWay}" Visibility="{Binding ViewModel.BoundaryVisible, Converter={StaticResource BoolToVis}}" />
                <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="打开程序目录" Command="{Binding ViewModel.OpenStdioFolderCommand}" ToolTipService.ToolTip="打开 LlmWiki.McpStdio.exe 所在目录，便于在外部客户端中配置" AutomationProperties.Name="打开 stdio 程序目录" />
              </StackPanel>
            </ui:CardExpander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Page>