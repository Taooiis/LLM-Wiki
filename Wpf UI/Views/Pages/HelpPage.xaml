<Page
  x:Class="LLM_Wiki.Views.Pages.HelpPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="使用帮助"
  d:DataContext="{d:DesignInstance local:HelpPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="800"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  PreviewKeyDown="OnPagePreviewKeyDown"
  mc:Ignorable="d">
  <Grid Margin="24,24,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="使用帮助" />
      <TextBlock
        Margin="0,4,0,0"
        FontSize="{StaticResource FontSizeBody}"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="按任务查找操作步骤。"
        TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" MinWidth="240" MaxWidth="260" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 帮助主题 -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TextBox
          x:Name="TopicFilterBox"
          Grid.Row="0"
          Margin="0,0,0,8"
          Icon="Search24"
          PlaceholderText="筛选帮助主题…"
          Text="{Binding ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ListView
          x:Name="TopicList"
          Grid.Row="1"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource ProjectListItem}"
          ItemsSource="{Binding ViewModel.FilteredTopics}"
          SelectedItem="{Binding ViewModel.SelectedTopic, Mode=TwoWay}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid MinHeight="48">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <!-- 正文 -->
      <Border Grid.Column="2" Padding="28,24" Background="{DynamicResource ReadingSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding ViewModel.SelectedTopic.Title}" TextWrapping="Wrap" />
                  <TextBlock Margin="0,6,0,0" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.SelectedTopic.Summary}" TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button
                  Grid.Column="1"
                  VerticalAlignment="Top"
                  Content="{Binding ViewModel.ReturnLabel}"
                  Icon="ArrowLeft24"
                  Click="OnReturnClick"
                  Visibility="{Binding ViewModel.HasReturnContext, Converter={StaticResource BoolToVis}}" />
              </Grid>

              <!-- 就地提示条（07）：快速上手没有本机工具也可用手动复制，点击切到复制方式 -->
              <StackPanel
                Margin="0,12,0,0"
                Visibility="{Binding ViewModel.ShowCopyHint, Converter={StaticResource BoolToVis}}">
                <ui:InfoBar
                  IsClosable="False"
                  IsOpen="True"
                  Message="没有本机工具也可使用手动复制。"
                  Severity="Informational" />
                <ui:Button
                  Margin="0,6,0,0"
                  Padding="8,2"
                  HorizontalAlignment="Left"
                  Appearance="Secondary"
                  Command="{Binding ViewModel.ShowCopyModeCommand}"
                  Content="查看复制方式 →" />
              </StackPanel>

              <!-- 方式切换：同一主题内，不跳另一页（07§2；WPF-UI 4.3.0 无 ui:TabControl，原生 TabControl 已由库主题样式接管） -->
              <TabControl
                Margin="0,16,0,0"
                SelectedIndex="{Binding ViewModel.ReadMode, Mode=TwoWay}"
                Visibility="{Binding ViewModel.ShowModeTabs, Converter={StaticResource BoolToVis}}">
                <TabItem Header="本机执行">
                  <StackPanel Margin="4,12,4,4">
                    <TextBlock
                      FontSize="{StaticResource FontSizeBody}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding ViewModel.ModeHint}"
                      TextWrapping="Wrap" />
                    <!-- AlternationCount 驱动步骤圆圈编号（07：编号是简单文字圆底） -->
                    <ItemsControl
                      Margin="0,12,0,0"
                      AlternationCount="99"
                      ItemsSource="{Binding ViewModel.SelectedTopic.LocalSteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                              Grid.Column="0"
                              Width="32"
                              Height="32"
                              VerticalAlignment="Top"
                              Background="{DynamicResource PrimaryBackgroundBrush}"
                              BorderBrush="{DynamicResource StrokeBrush}"
                              BorderThickness="1"
                              CornerRadius="16">
                              <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                FontWeight="SemiBold"
                                Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AddOne}}" />
                            </Border>
                            <TextBlock
                              Grid.Column="1"
                              Margin="12,3,0,0" LineHeight="24"
                              FontSize="{StaticResource FontSizeBody}"
                              Text="{Binding}"
                              TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </TabItem>
                <TabItem Header="手动复制">
                  <StackPanel Margin="4,12,4,4">
                    <TextBlock
                      FontSize="{StaticResource FontSizeBody}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding ViewModel.ModeHint}"
                      TextWrapping="Wrap" />
                    <ItemsControl
                      Margin="0,12,0,0"
                      AlternationCount="99"
                      ItemsSource="{Binding ViewModel.SelectedTopic.CopySteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                              Grid.Column="0"
                              Width="32"
                              Height="32"
                              VerticalAlignment="Top"
                              Background="{DynamicResource PrimaryBackgroundBrush}"
                              BorderBrush="{DynamicResource StrokeBrush}"
                              BorderThickness="1"
                              CornerRadius="16">
                              <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                FontWeight="SemiBold"
                                Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AddOne}}" />
                            </Border>
                            <TextBlock
                              Grid.Column="1"
                              Margin="12,3,0,0" LineHeight="24"
                              FontSize="{StaticResource FontSizeBody}"
                              Text="{Binding}"
                              TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </TabItem>
              </TabControl>

              <!-- 主题正文 -->
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ViewModel.SelectedTopic.Sections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,16">
                      <TextBlock FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
                      <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontSizeBody}" Text="{Binding}" TextWrapping="Wrap" LineHeight="24" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 就地链接 -->
              <WrapPanel Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding ViewModel.SelectedTopic.Links}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ui:Button
                        Margin="0,0,8,8"
                        Content="{Binding Label}"
                        Tag="{Binding PageKey}"
                        Click="OnLinkClick"
                        Appearance="Secondary" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>

              <TextBlock
                Margin="0,12,0,0"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="资料保持原格式；整理完成后，请核对来源并确认结果。"
                TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <!-- 无搜索结果 -->
          <Border Background="{DynamicResource ReadingSurfaceBrush}" Visibility="{Binding ViewModel.HasSearchResult, Converter={StaticResource InvBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="没有匹配的帮助主题" />
              <TextBlock Margin="0,6,0,0" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="按标题或关键词筛选；清空筛选可查看全部主题。" TextWrapping="Wrap" />
              <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="清空筛选" Click="OnClearSearchClick" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
