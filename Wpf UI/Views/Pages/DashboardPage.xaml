<Page
  x:Class="LLM_Wiki.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  Title="DashboardPage"
  d:DataContext="{d:DesignInstance local:DashboardPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <dialogs:ConfirmationDialog x:Key="ConfirmDlg" />
  </Page.Resources>

  <!-- 响应式布局容器：MaxWidth 限宽居中，窄窗口自动收缩 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="1100">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 标题：统一引用全局样式 -->
      <TextBlock Grid.Row="0"
                 Style="{StaticResource PageTitleText}"
                 Text="知识库" />

      <!-- 工具栏 -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：KB 搜索 -->
        <ui:TextBox
          Grid.Column="0"
          Margin="0,0,8,0"
          PlaceholderText="搜索知识库..."
          Text="{Binding ViewModel.SearchText, Mode=TwoWay}"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />

        <!-- 中间：KB 列表 -->
        <ui:ListView
          x:Name="KbList"
          Grid.Column="1"
          ItemsSource="{Binding ViewModel.Kbs, Mode=OneWay}"
          SelectedItem="{Binding ViewModel.SelectedKb, Mode=TwoWay}"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          BorderThickness="0"
          ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ui:ListView.ItemTemplate>
            <DataTemplate>
              <Border Padding="8,4" Margin="2"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <ui:Button Grid.Column="1"
                             Content="编辑"
                             Margin="8,0,0,0"
                             Icon="Edit24"
                             FontSize="{StaticResource FontSizeCaption}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ui:ListView.ItemTemplate>
        </ui:ListView>

        <!-- 右侧：KB 操作 -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
          <ui:TextBox
            x:Name="KbNameInput"
            Width="140"
            Margin="0,0,8,0"
            PlaceholderText="新知识库名称"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />
          <ui:Button
            Content="新建"
            Command="{Binding ViewModel.CreateKbCommand}"
            CommandParameter="{Binding ElementName=KbNameInput, Path=Text}"
            Margin="0,0,4,0"
            Icon="Add24" />
          <ui:Button
            x:Name="DeleteBtn"
            Content="删除"
            Click="OnDeleteClick"
            Icon="Delete24" />
        </StackPanel>
      </Grid>

      <!-- 内容区 -->
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：文件列表 -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ui:TextBox
            Grid.Row="0"
            Margin="0,0,8,8"
            PlaceholderText="搜索文件..."
            Text="{Binding ViewModel.SearchText, Mode=TwoWay}"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />
          <ui:ListView
            x:Name="FileList"
            Grid.Row="1"
            ItemsSource="{Binding ViewModel.Files, Mode=OneWay}"
            Background="Transparent"
            BorderThickness="0"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="FileList_SelectionChanged">
            <ui:ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Padding="8,6" Text="{Binding}" />
              </DataTemplate>
            </ui:ListView.ItemTemplate>
          </ui:ListView>
        </Grid>

        <!-- 右侧：文件预览（撑满剩余空间，不再固定 200 高） -->
        <ui:TextBox
          x:Name="PreviewBox"
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Stretch"
          VerticalContentAlignment="Top"
          Text="{Binding ViewModel.MarkdownText, Mode=TwoWay}"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
