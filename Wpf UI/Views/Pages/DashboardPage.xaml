<Page
  x:Class="LLM_Wiki.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  xmlns:controls="clr-namespace:LLM_Wiki.Controls"
  xmlns:helpers="clr-namespace:LLM_Wiki.Helpers"
  Title="DashboardPage"
  d:DataContext="{d:DesignInstance local:DashboardPage, IsDesignTimeCreatable=False}"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <dialogs:ConfirmationDialog x:Key="ConfirmDlg" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <helpers:GreaterThanZeroConverter x:Key="GreaterThanZero" />
    <helpers:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroVis" />
    <helpers:CountToEmptyVisibilityConverter x:Key="CountToEmptyVis" />
    <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <helpers:PendingHintConverter x:Key="PendingHint" />
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="1280">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ============ 标题区：首页 + 说明 + 新建知识库（设计文档 01§3.1） ============ -->
      <Grid Grid.Row="0" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitleText}" Text="首页" />
          <TextBlock
            Margin="0,-8,0,0"
            Text="管理知识库、源文档和知识更新状态。"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        <ui:Button
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Appearance="Primary"
          Content="新建知识库"
          Icon="Add24"
          Command="{Binding ViewModel.StartCreateKbCommand}"
          Visibility="{Binding ViewModel.IsCreatingKb, Converter={StaticResource InverseBoolToVis}}" />
      </Grid>

      <!-- ============ 内联新建知识库（设计文档 01§7） ============ -->
      <Border
        Grid.Row="1"
        Margin="0,0,0,16"
        Padding="16"
        Style="{StaticResource CardBorder}"
        Visibility="{Binding ViewModel.IsCreatingKb, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock
              VerticalAlignment="Center"
              Text="新知识库名称："
              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBox
              Width="280"
              Margin="8,0,12,0"
              PlaceholderText="中文、英文、数字、下划线、中划线"
              Text="{Binding ViewModel.NewKbName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
              Appearance="Primary"
              Content="创建"
              Margin="0,0,8,0"
              Command="{Binding ViewModel.CreateKbCommand}" />
            <ui:Button
              Content="取消"
              Command="{Binding ViewModel.CancelCreateKbCommand}" />
            <TextBlock
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource DangerBrush}"
              Text="{Binding ViewModel.NewKbError}" />
          </StackPanel>
          <TextBlock
            Margin="0,8,0,0"
            FontSize="{StaticResource FontSizeCaption}"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="创建后会生成 purpose.md、schema.md 与 raw/、wiki/ 目录骨架。" />
        </StackPanel>
      </Border>

      <!-- ============ 欢迎 Banner（设计文档 01§3.2：纯色 #252B30，不用渐变） ============ -->
      <Border
        Grid.Row="2"
        Height="116"
        Margin="0,0,0,16"
        Padding="24"
        CornerRadius="10"
        Background="{DynamicResource BannerBackgroundBrush}">
        <Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Text="欢迎使用 LLM Wiki" />
            <TextBlock
              Margin="0,6,0,0"
              Text="把分散的资料整理为可持续维护的知识库。"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
              <ui:Button
                Appearance="Primary"
                Content="打开源文档"
                Margin="0,0,8,0"
                Command="{Binding ViewModel.GoSourceCommand}" />
              <ui:Button
                Appearance="Secondary"
                Content="查看工作流"
                Command="{Binding ViewModel.GoWorkflowCommand}" />
            </StackPanel>
          </StackPanel>
          <ui:SymbolIcon
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontSize="56"
            Symbol="Book24"
            Foreground="#2260CDFF" />
        </Grid>
      </Border>

      <!-- ============ 四张统计卡（设计文档 01§3.3：宽屏一行，点击跳转） ============ -->
      <Grid Grid.Row="3" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 知识库数 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Cursor="Hand">
          <Border.InputBindings>
            <MouseBinding Command="{Binding ViewModel.GoTreeCommand}" Gesture="LeftClick" />
          </Border.InputBindings>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Book24" FontSize="20" Foreground="{DynamicResource AccentLightBrush}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatCardLabel}" Text="知识库数量" />
            </StackPanel>
            <TextBlock Style="{StaticResource StatCardValue}" Text="{Binding ViewModel.KbCount}" />
            <TextBlock Style="{StaticResource StatCardLabel}" Text="个知识库" />
          </StackPanel>
        </Border>

        <!-- 源文档数（当前选中库口径） -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Cursor="Hand">
          <Border.InputBindings>
            <MouseBinding Command="{Binding ViewModel.GoSourceCommand}" Gesture="LeftClick" />
          </Border.InputBindings>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Document24" FontSize="20" Foreground="{DynamicResource AccentLightBrush}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatCardLabel}" Text="源文档数量" />
            </StackPanel>
            <TextBlock Style="{StaticResource StatCardValue}" Text="{Binding ViewModel.SourceDocCount}" />
            <TextBlock Style="{StaticResource StatCardLabel}" Text="份源文档 · 当前知识库" />
          </StackPanel>
        </Border>

        <!-- 待处理变更 -->
        <Border Grid.Column="4" Style="{StaticResource CardBorder}" Cursor="Hand">
          <Border.InputBindings>
            <MouseBinding Command="{Binding ViewModel.GoPendingCommand}" Gesture="LeftClick" />
          </Border.InputBindings>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatCardLabel}" Text="待处理变更" />
            </StackPanel>
            <TextBlock Text="{Binding ViewModel.PendingChangeCount}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource StatCardValue}">
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ViewModel.PendingChangeCount, Converter={StaticResource GreaterThanZero}}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource StatCardLabel}">
              <TextBlock.Text>
                <Binding Path="ViewModel.PendingChangeCount" Mode="OneWay" Converter="{StaticResource PendingHint}" />
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- 存储状态 -->
        <Border Grid.Column="6" Style="{StaticResource CardBorder}" Cursor="Hand">
          <Border.InputBindings>
            <MouseBinding Command="{Binding ViewModel.GoConfigCommand}" Gesture="LeftClick" />
          </Border.InputBindings>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Database24" FontSize="20" Foreground="{DynamicResource SuccessBrush}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatCardLabel}" Text="存储状态" />
            </StackPanel>
            <TextBlock Style="{StaticResource StatCardValue}" Text="{Binding ViewModel.StorageStatusText}" />
            <TextBlock
              Style="{StaticResource StatCardLabel}"
              TextTrimming="CharacterEllipsis"
              ToolTip="{Binding ViewModel.StoragePathDisplay}"
              Text="{Binding ViewModel.StoragePathDisplay}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ 主内容：左我的知识库 + 右待处理/快捷入口/存储（设计文档 01§2） ============ -->
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- 我的知识库 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
              <TextBlock Style="{StaticResource SectionTitleText}" Text="我的知识库" />
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Bottom"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="{Binding ViewModel.KbCount, Mode=OneWay}" /><Run Text=" 个" />
              </TextBlock>
            </StackPanel>

            <ui:TextBox
              Grid.Row="1"
              Margin="0,0,0,12"
              PlaceholderText="搜索知识库…"
              Icon="Search24"
              Text="{Binding ViewModel.KbSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 知识库卡片列表：单击切换当前库，双击进入源文档页 -->
            <ui:ListView
              Grid.Row="2"
              ItemsSource="{Binding ViewModel.KbsView, Mode=OneWay}"
              SelectedValue="{Binding ViewModel.SelectedKb, Mode=TwoWay}"
              SelectedValuePath="Name"
              Background="Transparent"
              BorderThickness="0"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              MouseDoubleClick="OnKbCardDoubleClick">
              <ui:ListView.ItemTemplate>
                <DataTemplate>
                  <Border
                    Padding="12,10"
                    Margin="0,2"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="2,2,2,2"
                    Cursor="Hand">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <!-- 当前知识库：低饱和蓝底 + 蓝色细边框（设计文档 01§4 选中标记） -->
                          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                            <Setter Property="Background" Value="#AA163A55" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock
                          FontSize="14"
                          FontWeight="SemiBold"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis" />
                        <TextBlock
                          Margin="0,2,0,0"
                          FontSize="{StaticResource FontSizeCaption}"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                          <Run Text="{Binding SourceCount, Mode=OneWay}" /><Run Text=" 份文档" />
                          <Run Text="  ·  创建于 " /><Run Text="{Binding CreatedText, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Icon="Delete24"
                        ToolTip="删除该知识库"
                        Click="OnDeleteKbClick"
                        CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- 空状态（设计文档 01§4） -->
            <controls:EmptyState
              Grid.Row="2"
              Icon="📚"
              Title="还没有知识库"
              Description="点击右上角「新建知识库」创建第一个知识库，之后即可上传文档并生成 Wiki。"
              Visibility="{Binding ViewModel.KbItems.Count, Converter={StaticResource CountToEmptyVis}}" />
          </Grid>
        </Border>

        <!-- 右列：待处理变更 / 快捷入口 / 存储位置 -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 待处理变更（设计文档 01§5：最多 5 条 + 去处理 + 查看全部） -->
          <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource SectionTitleText}" Text="待处理变更" />
                <Border
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Padding="8,2"
                  CornerRadius="10"
                  Background="#33FF6B6B"
                  Visibility="{Binding ViewModel.PendingChangeCount, Converter={StaticResource GreaterThanZeroVis}}">
                  <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource DangerBrush}">
                    <Run Text="{Binding ViewModel.PendingChangeCount, Mode=OneWay}" /><Run Text=" 项待处理" />
                  </TextBlock>
                </Border>
              </StackPanel>

              <!-- 最近变更（真实 .changes.json 数据） -->
              <ItemsControl ItemsSource="{Binding ViewModel.RecentChanges}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Padding="7,1"
                        CornerRadius="4">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#33C5C5C5" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                <Setter Property="Background" Value="#336CCB5F" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsModify}" Value="True">
                                <Setter Property="Background" Value="#3360A5FA" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                <Setter Property="Background" Value="#33FF6B6B" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock
                          FontSize="11"
                          Text="{Binding ActionLabel}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      </Border>
                      <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{Binding FileName}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FileName}" />
                      <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding TimeText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 空状态：无待处理 -->
              <TextBlock
                Margin="0,4"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Visibility="{Binding ViewModel.PendingChangeCount, Converter={StaticResource CountToEmptyVis}}">
                当前知识库已同步，没有待处理变更。
              </TextBlock>

              <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:Button
                  Appearance="Primary"
                  Content="去处理"
                  Margin="0,0,8,0"
                  Command="{Binding ViewModel.GoPendingCommand}" />
                <ui:Button
                  Appearance="Secondary"
                  Content="查看全部"
                  Command="{Binding ViewModel.GoSourceCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 快捷入口（设计文档 01§6：2×2，点击直达页面） -->
          <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleText}" Text="快捷入口" />
              <UniformGrid Columns="2" Rows="2">
                <ui:Button
                  Margin="0,0,8,8"
                  Padding="12,14"
                  HorizontalContentAlignment="Left"
                  Appearance="Secondary"
                  Command="{Binding ViewModel.GoSourceCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="18" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="上传文档" />
                  </StackPanel>
                </ui:Button>
                <ui:Button
                  Margin="0,0,0,8"
                  Padding="12,14"
                  HorizontalContentAlignment="Left"
                  Appearance="Secondary"
                  Command="{Binding ViewModel.GoTreeCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="浏览目录" />
                  </StackPanel>
                </ui:Button>
                <ui:Button
                  Margin="0,0,8,0"
                  Padding="12,14"
                  HorizontalContentAlignment="Left"
                  Appearance="Secondary"
                  Command="{Binding ViewModel.GoIngestCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="生成 Ingest" />
                  </StackPanel>
                </ui:Button>
                <ui:Button
                  Padding="12,14"
                  HorizontalContentAlignment="Left"
                  Appearance="Secondary"
                  Command="{Binding ViewModel.GoLintCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="运行 Lint" />
                  </StackPanel>
                </ui:Button>
              </UniformGrid>
            </StackPanel>
          </Border>

          <!-- 存储位置（设计文档 01§6：完整路径 + 真实状态 + 打开配置） -->
          <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleText}" Text="当前存储位置" />
              <TextBlock
                FontFamily="Consolas"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding ViewModel.StoragePathDisplay}"
                Text="{Binding ViewModel.StoragePathDisplay}" />
              <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SuccessBrush}"
                               Visibility="{Binding ViewModel.StorageIsOk, Converter={StaticResource BoolToVis}}" />
                <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding ViewModel.StorageIsOk, Converter={StaticResource InverseBoolToVis}}" />
                <TextBlock
                  Margin="6,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="{StaticResource FontSizeCaption}"
                  Text="{Binding ViewModel.StorageStatusText}" />
              </StackPanel>
              <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:Button
                  Appearance="Primary"
                  Content="打开配置"
                  Margin="0,0,8,0"
                  Command="{Binding ViewModel.GoConfigCommand}" />
                <ui:Button
                  Appearance="Secondary"
                  Content="打开文件夹"
                  Command="{Binding ViewModel.OpenStorageFolderCommand}"
                  IsEnabled="{Binding ViewModel.StorageIsOk}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
