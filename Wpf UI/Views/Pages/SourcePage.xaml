<Page
  x:Class="LLM_Wiki.Views.Pages.SourcePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  Title="SourcePage"
  d:DataContext="{d:DesignInstance local:SourcePage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <dialogs:EditorDialog x:Key="EditorDlg" />
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题 + 工具栏 -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" FontSize="20" FontWeight="Medium" Text="源文档" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:TextBox
          x:Name="NewFileNameInput"
          Width="160"
          Margin="0,0,8,0"
          Padding="6,2"
          PlaceholderText="新建文件名（.md/.txt）"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />
        <ui:Button
          Content="新建"
          Command="{Binding ViewModel.CreateFileCommand}"
          CommandParameter="{Binding ElementName=NewFileNameInput, Path=Text}"
          Margin="4,0,8,0"
          Icon="Fluent24" />
        <ui:Button
          Content="上传"
          Command="{Binding ViewModel.UploadFileCommand}"
          CommandParameter="{Binding ElementName=KbList, Path=SelectedItem}"
          Margin="4,0,0,0"
          Icon="Fluent24" />
        <ui:Button
          Content="刷新"
          Command="{Binding ViewModel.RefreshCommand}"
          Margin="8,0,0,0"
          Icon="Fluent24" />
      </StackPanel>
    </Grid>

    <!-- 内容区：左文件列表 + 右预览/编辑 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：文件列表 -->
      <StackPanel Grid.Column="0">
        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="8,8,8,4" Text="文件列表" />
        <ui:ListView
          x:Name="FileList"
          ItemsSource="{Binding ViewModel.Files, Mode=OneWay}"
          Background="Transparent"
          BorderThickness="0"
          SelectionChanged="FileList_SelectionChanged">
          <ui:ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Padding="8,6" Text="{Binding}" />
            </DataTemplate>
          </ui:ListView.ItemTemplate>
        </ui:ListView>
      </StackPanel>

      <!-- 右侧：预览 + 编辑按钮 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ViewModel.SelectedFile, TargetNullValue='请选择文件', FallbackValue='请选择文件'}" />
          <ui:Button
            Grid.Column="1"
            x:Name="EditButton"
            Content="编辑"
            Click="OnEditClick"
            Margin="8,0,0,0"
            Icon="Fluent24"
            IsEnabled="False" />
        </Grid>

        <ui:TextBox
          x:Name="PreviewText"
          Grid.Row="1"
          Margin="0,8,0,0"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
          IsReadOnly="True"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          Padding="8" />
      </Grid>
    </Grid>

    <!-- 待处理变更区 -->
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" Text="待处理变更" />
      <ui:ListView
        Grid.Row="1"
        ItemsSource="{Binding ViewModel.Changes, Mode=OneWay}"
        Background="Transparent"
        BorderThickness="0">
        <ui:ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,2">
              <TextBlock Text="{Binding Time}" Width="120" />
              <TextBlock Text="{Binding Action}" Width="80" />
              <TextBlock Text="{Binding File}" />
              <ui:Button
                Content="清除"
                Command="{Binding DataContext.ViewModel.ClearChangeCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                CommandParameter="{Binding File}"
                Margin="8,0,0,0"
                Icon="Fluent24" />
            </StackPanel>
          </DataTemplate>
        </ui:ListView.ItemTemplate>
      </ui:ListView>
    </Grid>
  </Grid>
</Page>
