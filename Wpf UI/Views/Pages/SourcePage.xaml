<Page
  x:Class="LLM_Wiki.Views.Pages.SourcePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:LLM_Wiki.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="资料"
  d:DataContext="{d:DesignInstance local:SourcePage, IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">
  <Page.Resources>
    <dialogs:UnsavedChangesDialog x:Key="UnsavedDlg" />
  </Page.Resources>

  <Grid Margin="{StaticResource PageContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 页头 -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="资料" />
        <TextBlock
          Margin="0,4,0,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          TextTrimming="CharacterEllipsis">
          <Run Text="{Binding ViewModel.SelectedKb, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding ViewModel.Rows.Count, Mode=OneWay, StringFormat='{}{0} 份资料'}" />
          <Run Text=" · " />
          <Run Text="{Binding ViewModel.PendingText, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding ViewModel.PageHint, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <ui:Button Content="新建资料" Icon="Add24" Click="OnNewClick" Margin="0,0,8,0" />
        <ui:Button Content="添加文件" Icon="ArrowUpload24" Click="OnAddFilesClick" Appearance="Primary" Margin="0,0,8,0" />
        <ui:Button Content="回收站" Icon="Delete24" Click="OnTrashClick" Margin="0,0,8,0" />
        <ui:Button Content="打开文件夹" Icon="FolderOpen24" Click="OnOpenFolderClick" Margin="0,0,8,0" />
        <ui:Button Content="刷新" Icon="ArrowSync24" Click="OnRefreshClick" />
      </StackPanel>
    </Grid>

    <!-- 导入结果摘要 -->
    <Border
      Grid.Row="1"
      Margin="0,0,0,10"
      Padding="12,8"
      CornerRadius="8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
      BorderThickness="1"
      Visibility="{Binding ViewModel.ImportSummary, Converter={StaticResource StringToVisibility}}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.ImportSummary}" />
        <ItemsControl ItemsSource="{Binding ViewModel.ImportResults, Mode=OneWay}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding Name, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding StatusText, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding Detail, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 主内容 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左栏：筛选 + 列表 -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBox
          Grid.Row="0"
          Margin="0,0,0,8"
          PlaceholderText="筛选资料文件名…"
          Icon="Search24"
          Text="{Binding ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ComboBox
          Grid.Row="1"
          MinHeight="32"
          Margin="0,0,0,8"
          ItemsSource="{Binding ViewModel.TypeFilters}"
          SelectedItem="{Binding ViewModel.TypeFilter, Mode=TwoWay}" />

        <Grid Grid.Row="2">
          <ui:ListView
            x:Name="FileList"
            ItemsSource="{Binding ViewModel.FilteredRows, Mode=OneWay}"
            SelectionChanged="OnFileSelectionChanged"
            Background="Transparent"
            BorderThickness="0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ui:ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox
                    Grid.Column="0"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    ToolTip="勾选后可以批量整理或移入回收站" />
                  <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Name, Converter={StaticResource FileNodeIcon}}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding MetaText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ui:ListView.ItemTemplate>
          </ui:ListView>
          <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding ViewModel.Rows.Count, Converter={StaticResource CountToEmptyVis}}">
            <TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Text="还没有资料" />
            <TextBlock Margin="0,6,0,0" MaxWidth="260" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="添加 md/txt/docx/xlsx 文件；应用保持原格式，不转 Markdown。" />
            <ui:Button Margin="0,12,0,0" Content="添加文件" Appearance="Primary" Icon="ArrowUpload24" Click="OnAddFilesClick" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{Binding ViewModel.SelectedCountText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <ui:Button Content="整理所选" Command="{Binding ViewModel.OrganizeSelectedCommand}" IsEnabled="{Binding ViewModel.HasSelection}" Appearance="Primary" Margin="0,0,8,0" />
              <ui:Button Content="移入回收站" Command="{Binding ViewModel.MoveSelectedToTrashCommand}" IsEnabled="{Binding ViewModel.HasSelection}" />
              <ui:Button Content="撤销上次移除" Command="{Binding ViewModel.UndoLastTrashCommand}" Margin="8,0,0,0" Visibility="{Binding ViewModel.UndoTrashId, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- 右栏：资料详情 / 工作区 -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Margin="0,0,0,8"
          Padding="12,8"
          CornerRadius="8"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1"
          Visibility="{Binding ViewModel.CurrentInfo, Converter={StaticResource NullToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.CurrentInfo.Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.CurrentInfo.PreviewHint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Content="导出文件" Command="{Binding ViewModel.ExportCurrentCommand}" Margin="0,0,8,0" />
              <ui:Button Content="打开原件" Click="OnOpenOriginalClick" />
            </StackPanel>
          </Grid>
        </Border>

        <controls:DocumentWorkspace Grid.Row="1" DataContext="{Binding ViewModel.Workspace}">
          <controls:DocumentWorkspace.EmptyAction>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <ui:Button Content="添加文件" Click="OnAddFilesClick" Appearance="Primary" Margin="0,0,8,0" Icon="ArrowUpload24" />
              <ui:Button Content="新建资料" Click="OnNewClick" Icon="Add24" />
            </StackPanel>
          </controls:DocumentWorkspace.EmptyAction>
        </controls:DocumentWorkspace>
      </Grid>
    </Grid>

    <!-- 无库引导 -->
    <Border
      Grid.Row="0"
      Grid.RowSpan="3"
      Background="{DynamicResource AppBackgroundBrush}"
      Visibility="{Binding ViewModel.HasKb, Converter={StaticResource InvBoolToVis}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
        <TextBlock FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="创建你的第一个知识库" />
        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="把资料和整理结果放在同一个地方。创建后即可添加资料。" />
        <ui:Button Margin="0,16,0,0" Content="新建知识库" Appearance="Primary" Click="OnCreateKbClick" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
