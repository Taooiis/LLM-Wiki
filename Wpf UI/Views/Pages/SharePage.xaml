<Page
  x:Class="LLM_Wiki.Views.Pages.SharePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:helpers="clr-namespace:LLM_Wiki.Helpers"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  Title="SharePage"
  d:DataContext="{d:DesignInstance local:SharePage, IsDesignTimeCreatable=False}"
  ScrollViewer.CanContentScroll="False"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <helpers:InverseBoolConverter x:Key="InverseBool" />
    <helpers:CountToEmptyVisibilityConverter x:Key="CountToEmptyVis" />
    <dialogs:ConfirmationDialog x:Key="McpWriteDlg" />
  </Page.Resources>

  <!-- CanContentScroll=False 关闭 NavigationView 的动态滚动宿主，页面自身滚动 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="1000">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ 标题 ============ -->
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Style="{StaticResource PageTitleText}" Text="分享" />
        <TextBlock
          Margin="0,-8,0,0"
          Text="在局域网内安全地只读查看当前知识库。"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      </StackPanel>

      <!-- ============ 服务状态卡（设计文档 05§3） ============ -->
      <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeSectionTitle}"
                FontWeight="SemiBold"
                Text="局域网分享服务" />

              <!-- 状态徽标：颜色 + 文字双重区分（设计文档 07§7） -->
              <Border
                Margin="10,0,0,0"
                Padding="8,2"
                VerticalAlignment="Center"
                CornerRadius="10">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#33C5C5C5" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewModel.IsRunning}" Value="True">
                        <Setter Property="Background" Value="#336CCB5F" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ViewModel.HasError}" Value="True">
                        <Setter Property="Background" Value="#33FF6B6B" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon
                    FontSize="12"
                    VerticalAlignment="Center"
                    Symbol="Circle24"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding ViewModel.IsRunning, Converter={StaticResource InverseBoolToVis}}" />
                  <ui:SymbolIcon
                    FontSize="12"
                    VerticalAlignment="Center"
                    Symbol="CheckmarkCircle24"
                    Foreground="{DynamicResource SuccessBrush}"
                    Visibility="{Binding ViewModel.IsRunning, Converter={StaticResource BoolToVis}}" />
                  <TextBlock
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Text="{Binding ViewModel.StatusText}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock
              Margin="0,8,0,0"
              Text="启动后，其他设备可通过浏览器只读浏览当前知识库；不提供任何写操作。"
              TextWrapping="Wrap"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- 未选知识库提示 -->
            <TextBlock
              Margin="0,8,0,0"
              Foreground="{DynamicResource WarningBrush}"
              TextWrapping="Wrap"
              Text="{Binding ViewModel.EmptyKbHint}" />

            <!-- 启动失败：原因 + 重试 -->
            <StackPanel
              Margin="0,8,0,0"
              Orientation="Horizontal"
              Visibility="{Binding ViewModel.HasError, Converter={StaticResource BoolToVis}}">
              <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource DangerBrush}"
                TextWrapping="Wrap"
                Text="{Binding ViewModel.LastError, StringFormat='启动失败：{0}'}" />
              <ui:Button
                Content="重试"
                Appearance="Secondary"
                Command="{Binding ViewModel.StartShareCommand}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding ViewModel.ToggleText}" />
            <ui:ToggleSwitch
              IsChecked="{Binding ViewModel.IsRunning, Mode=OneWay}"
              IsEnabled="{Binding ViewModel.CanToggle}"
              Command="{Binding ViewModel.ToggleShareCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ 地址卡 + PIN 卡（仅运行中） ============ -->
      <Grid
        Grid.Row="2"
        Margin="0,0,0,16"
        Visibility="{Binding ViewModel.ShowConnectionInfo, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- 访问地址 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="访问地址" />
            <TextBlock
              Margin="0,-6,0,10"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="其他设备在浏览器打开以下地址并输入 PIN。多网卡时逐条列出。" />

            <TextBlock
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="本机：" />
            <ui:TextBox
              Margin="0,2,0,0"
              FontFamily="Consolas"
              FontSize="12"
              IsReadOnly="True"
              Text="{Binding ViewModel.LocalAddress, Mode=OneWay}" />

            <TextBlock
              Margin="0,10,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="局域网（其他设备用这些）：" />
            <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding ViewModel.LanAddresses, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:TextBox
                    Margin="0,2,0,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    Text="{Binding Mode=OneWay}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              Margin="0,4,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="未检测到局域网地址：请确认已连接网络，或让其他设备用上面的本机地址（仅本机可用）。"
              TextWrapping="Wrap"
              Visibility="{Binding ViewModel.LanAddresses.Count, Converter={StaticResource CountToEmptyVis}}" />
            <TextBlock
              Margin="0,4,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding ViewModel.FriendlyAddress, StringFormat='mDNS 地址：{0}'}"
              TextWrapping="Wrap" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
              <ui:Button
                Content="复制地址"
                Appearance="Primary"
                Icon="Copy24"
                Margin="0,0,8,0"
                Command="{Binding ViewModel.CopyUrlCommand}" />
              <ui:Button
                Content="在浏览器中打开"
                Appearance="Secondary"
                Icon="Open24"
                Command="{Binding ViewModel.OpenLocalUrlCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 访问 PIN -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="访问 PIN" />
            <TextBlock
              Margin="0,-6,0,10"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="访问者输入此 4 位 PIN 才能打开页面。" />

            <TextBlock
              Margin="0,4,0,8"
              HorizontalAlignment="Center"
              FontFamily="Consolas"
              FontSize="34"
              FontWeight="Bold"
              Text="{Binding ViewModel.Pin}" />

            <ui:Button
              Content="复制 PIN"
              Appearance="Primary"
              Icon="Copy24"
              Margin="0,0,0,8"
              Command="{Binding ViewModel.CopyPinCommand}" />
            <ui:Button
              Content="重新生成 PIN"
              Appearance="Secondary"
              Icon="ArrowClockwise24"
              Command="{Binding ViewModel.RegeneratePinCommand}" />
            <TextBlock
              Margin="0,8,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              TextWrapping="Wrap"
              Text="重新生成后旧 PIN 立即失效，已连接的设备需要重新输入。" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- ============ 分享内容与安全边界（设计文档 05§5） ============ -->
      <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitleText}" Text="分享内容" />
          <WrapPanel>
            <StackPanel Margin="0,0,24,6" Orientation="Horizontal">
              <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="目录浏览" />
            </StackPanel>
            <StackPanel Margin="0,0,24,6" Orientation="Horizontal">
              <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Markdown 预览" />
            </StackPanel>
            <StackPanel Margin="0,0,24,6" Orientation="Horizontal">
              <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource SuccessBrush}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="文件下载" />
            </StackPanel>
            <StackPanel Margin="0,0,24,6" Orientation="Horizontal">
              <ui:SymbolIcon Symbol="DismissCircle24" FontSize="14" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="编辑" />
            </StackPanel>
            <StackPanel Margin="0,0,24,6" Orientation="Horizontal">
              <ui:SymbolIcon Symbol="DismissCircle24" FontSize="14" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="上传" />
            </StackPanel>
            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
              <ui:SymbolIcon Symbol="DismissCircle24" FontSize="14" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="删除" />
            </StackPanel>
          </WrapPanel>

          <Separator Margin="0,8,0,10" />

          <!-- 当前知识与范围 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
              <Run Text="当前知识库：" />
              <Run
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding ViewModel.SelectedKbText, Mode=OneWay}" />
            </TextBlock>
          </Grid>

          <TextBlock
            Margin="0,0,0,8"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding ViewModel.StoragePath}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="分享范围：" />
            <Run Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ViewModel.StoragePathText, Mode=OneWay}" />
          </TextBlock>

          <TextBlock
            TextWrapping="Wrap"
            FontSize="{StaticResource FontSizeCaption}"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="安全说明：访问者只能读取分享范围内的文件，不能修改本机知识库。写接口由服务端拒绝，不只是隐藏按钮。" />
        </StackPanel>
      </Border>

      <!-- ============ Agent 接入（MCP，设计 08§9） ============ -->
      <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  VerticalAlignment="Center"
                  FontSize="{StaticResource FontSizeSectionTitle}"
                  FontWeight="SemiBold"
                  Text="Agent 接入（MCP）" />
                <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="10">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#33C5C5C5" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.McpIsRunning}" Value="True">
                          <Setter Property="Background" Value="#336CCB5F" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewModel.McpWriteEnabled}" Value="True">
                          <Setter Property="Background" Value="#33F0A020" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock
                    FontSize="{StaticResource FontSizeCaption}"
                    Text="{Binding ViewModel.McpStatusText}" />
                </Border>
              </StackPanel>
              <TextBlock
                Margin="0,8,0,0"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="让支持 MCP 的通用 Agent（Claude Desktop、Cursor 等）读取当前知识库；默认只读，写入必须单独开启。" />
              <TextBlock
                Margin="0,8,0,0"
                TextWrapping="Wrap"
                Foreground="{DynamicResource WarningBrush}"
                Text="{Binding ViewModel.McpEmptyKbHint}" />
              <StackPanel
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Visibility="{Binding ViewModel.McpHasError, Converter={StaticResource BoolToVis}}">
                <TextBlock
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource DangerBrush}"
                  Text="{Binding ViewModel.McpLastError, StringFormat='启动失败：{0}'}" />
                <ui:Button
                  Content="重试"
                  Appearance="Secondary"
                  Command="{Binding ViewModel.RetryMcpCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
              <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="MCP 服务" />
              <ui:ToggleSwitch
                IsChecked="{Binding ViewModel.McpIsRunning, Mode=OneWay}"
                IsEnabled="{Binding ViewModel.McpCanStart}"
                Command="{Binding ViewModel.ToggleMcpCommand}" />
            </StackPanel>
          </Grid>

          <!-- 运行中：端点、令牌、档位、配置与最近调用 -->
          <StackPanel Visibility="{Binding ViewModel.McpShowDetails, Converter={StaticResource BoolToVis}}">
            <Separator Margin="0,14,0,12" />

            <TextBlock
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="端点（本机）：" />
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox
                Grid.Column="0"
                Margin="0,0,8,0"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                Text="{Binding ViewModel.McpEndpoint, Mode=OneWay}" />
              <ui:Button
                Grid.Column="1"
                Content="复制端点"
                Appearance="Secondary"
                Icon="Copy24"
                Command="{Binding ViewModel.CopyMcpEndpointCommand}" />
            </Grid>

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:ToggleSwitch
                IsChecked="{Binding ViewModel.McpAllowLan, Mode=OneWay}"
                Command="{Binding ViewModel.ToggleMcpLanCommand}" />
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="允许局域网访问（默认仅 127.0.0.1）" />
            </StackPanel>
            <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding ViewModel.McpLanEndpoints, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:TextBox
                    Margin="0,2,0,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    Text="{Binding Mode=OneWay}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              Margin="0,2,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="未检测到局域网地址：其他设备暂不可用。"
              TextWrapping="Wrap"
              Visibility="{Binding ViewModel.McpLanEndpoints.Count, Converter={StaticResource CountToEmptyVis}}" />

            <TextBlock
              Margin="0,12,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="访问令牌（客户端用 Bearer 方式携带）：" />
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox
                Grid.Column="0"
                Margin="0,0,8,0"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                Text="{Binding ViewModel.McpTokenDisplay, Mode=OneWay}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button
                  Content="{Binding ViewModel.McpTokenButtonText}"
                  Appearance="Secondary"
                  Margin="0,0,6,0"
                  Command="{Binding ViewModel.ToggleMcpTokenVisibilityCommand}" />
                <ui:Button
                  Content="复制"
                  Appearance="Secondary"
                  Icon="Copy24"
                  Margin="0,0,6,0"
                  Command="{Binding ViewModel.CopyMcpTokenCommand}" />
                <ui:Button
                  Content="重新生成"
                  Appearance="Secondary"
                  Icon="ArrowClockwise24"
                  Command="{Binding ViewModel.RegenerateMcpTokenCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock
              Margin="0,4,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              TextWrapping="Wrap"
              Text="重新生成后旧令牌立即失效，已连接的客户端会被断开。令牌不写入日志和错误详情。" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:ToggleSwitch
                IsChecked="{Binding ViewModel.McpWriteEnabled, Mode=OneWay}"
                Command="{Binding ViewModel.ToggleMcpWriteCommand}" />
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource WarningBrush}"
                Text="允许 Agent 写入 wiki/（修改会立即落盘，需二次确认）" />
            </StackPanel>

            <TextBlock
              Margin="0,12,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="客户端配置（HTTP 与 stdio 两种格式）：" />
            <ui:TextBox
              Margin="0,2,0,0"
              MinHeight="150"
              MaxHeight="220"
              FontFamily="Consolas"
              FontSize="11"
              AcceptsReturn="True"
              TextWrapping="NoWrap"
              VerticalScrollBarVisibility="Auto"
              IsReadOnly="True"
              Text="{Binding ViewModel.McpClientConfigJson, Mode=OneWay}" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
              <ui:Button
                Content="复制客户端配置"
                Appearance="Primary"
                Icon="Copy24"
                Command="{Binding ViewModel.CopyMcpClientConfigCommand}" />
            </StackPanel>

            <TextBlock
              Margin="0,14,0,4"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="已暴露能力：" />
            <TextBlock
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              TextWrapping="Wrap"
              Text="{Binding ViewModel.McpExposedToolsText}" />

            <TextBlock
              Margin="0,14,0,4"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="最近调用（仅时间、工具名、结果）：" />
            <ItemsControl ItemsSource="{Binding ViewModel.McpRecentCalls, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      Grid.Column="0"
                      FontFamily="Consolas"
                      FontSize="11"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="{Binding TimeText}" />
                    <TextBlock
                      Grid.Column="1"
                      FontFamily="Consolas"
                      FontSize="11"
                      TextTrimming="CharacterEllipsis"
                      Text="{Binding Tool}" />
                    <TextBlock
                      Grid.Column="2"
                      FontSize="11"
                      Text="{Binding StatusText}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="暂无调用记录。"
              Visibility="{Binding ViewModel.McpRecentCalls.Count, Converter={StaticResource CountToEmptyVis}}" />

            <TextBlock
              Margin="0,10,0,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              TextWrapping="Wrap"
              Text="安全边界：不提供删除、标记已处理、配置修改或路径切换工具；写入仅限 wiki/ 且禁止覆盖日志。Agent 的执行结果以实际文件变更与返回内容为准。" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
