<Page
  x:Class="LLM_Wiki.Views.Pages.SharePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="SharePage"
  d:DataContext="{d:DesignInstance local:SharePage, IsDesignTimeCreatable=False}"
  d:DesignHeight="500"
  d:DesignWidth="700"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="900">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <TextBlock Grid.Row="0" Style="{StaticResource PageTitleText}" Text="分享（局域网只读访问）" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,0,12">

        <!-- 开关卡片 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,16"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="只读分享服务" />
            <TextBlock Text="开启后，局域网内其它设备可通过浏览器只读浏览知识库。不支持上传/编辑/删除。" Margin="0,0,0,12" />
            <ui:ToggleSwitch
              OnContent="{Binding ViewModel.ToggleText}"
              OffContent="{Binding ViewModel.ToggleText}"
              IsChecked="{Binding ViewModel.IsRunning, Mode=TwoWay}"
              Command="{Binding ViewModel.IsRunning ? ViewModel.StopShareCommand : ViewModel.StartShareCommand}"
              Margin="0,0,0,12" />
            <TextBlock
              Text="{Binding ViewModel.Pin, StringFormat='访问 PIN: {0}'}"
              FontWeight="SemiBold"
              Margin="0,0,0,8"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
        </Border>

        <!-- 地址卡片 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,16"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="访问地址" />
            <TextBlock Text="手机或其它电脑在局域网内打开以下地址，输入 PIN 即可浏览：" Margin="0,0,0,8" />
            
            <TextBlock Text="本机地址：" FontWeight="SemiBold" Margin="0,8,0,4" />
            <ui:TextBox
              Text="{Binding ViewModel.LocalAddress, Mode=OneWay}"
              IsReadOnly="True"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />

            <TextBlock Text="局域网地址：" FontWeight="SemiBold" Margin="0,8,0,4" />
            <ItemsControl ItemsSource="{Binding ViewModel.LanAddresses, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:TextBox
                    Text="{Binding Mode=OneWay}"
                    IsReadOnly="True"
                    Margin="0,2,0,2"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="mDNS 友好地址：" FontWeight="SemiBold" Margin="0,8,0,4" />
            <ui:TextBox
              Text="{Binding ViewModel.FriendlyAddress, Mode=OneWay}"
              IsReadOnly="True"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />
            <TextBlock Text="(如为空表示 mDNS 不可用，请使用上面的 IP 地址)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <ui:Button
                Content="复制地址"
                Command="{Binding ViewModel.CopyUrlCommand}"
                Margin="0,0,8,0"
                Icon="Copy24" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 说明 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,16"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleText}" Text="使用说明" />
            <TextBlock Text="1. 点击开关启动分享服务（默认端口 8765）。" Margin="0,0,0,4" />
            <TextBlock Text="2. 在手机或其它电脑浏览器打开上方显示的地址。" Margin="0,0,0,4" />
            <TextBlock Text="3. 输入显示的 4 位 PIN 码进入只读页面。" Margin="0,0,0,4" />
            <TextBlock Text="4. 只读页面支持浏览目录树、预览与下载文档，不支持任何写操作。" Margin="0,0,0,4" />
            <TextBlock Text="5. 关闭开关即停止服务；程序退出自动停止。" Margin="0,0,0,4" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
