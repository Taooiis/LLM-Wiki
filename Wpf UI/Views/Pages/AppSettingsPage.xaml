<Page
  x:Class="LLM_Wiki.Views.Pages.AppSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="应用设置"
  d:DataContext="{d:DesignInstance local:AppSettingsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource PageContentMargin}" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="应用设置" />
      <TextBlock Margin="0,4,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="整个应用共享的存储位置、外观和版本信息；当前库的目标与规则请到“知识库设置”。" />

      <Border Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="存储" />
          <TextBlock Margin="0,8,0,0" Text="知识库根目录" FontWeight="SemiBold" />
          <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="该目录下每个子文件夹是一份知识库。切换只更换读取位置，不搬迁、合并或删除原目录文件。" TextWrapping="Wrap" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Text="{Binding ViewModel.WikisDirInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览文件夹" Command="{Binding ViewModel.BrowseFolderCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="应用路径" Appearance="Primary" Command="{Binding ViewModel.ApplyPathCommand}" IsEnabled="{Binding ViewModel.CanApply}" Margin="0,0,8,0" />
            <ui:Button Content="恢复默认" Command="{Binding ViewModel.ResetDefaultCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.PathStatus}" />
          </StackPanel>
          <TextBlock Margin="0,8,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.WikisDir, StringFormat='当前生效：{0}'}" TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="共享目录的读写权限由 Windows 管理。请避免多台设备同时维护同一份资料；修改者负责重新整理知识。UNC 共享本身不等于只读。" />
        </StackPanel>
      </Border>

      <Border Margin="0,10,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="外观" />
          <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="主题立即生效并持久化；不提供未实现的“跟随系统”。" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Button Content="深色" Command="{Binding ViewModel.SetThemeCommand}" CommandParameter="Dark" Margin="0,0,8,0" />
            <ui:Button Content="浅色" Command="{Binding ViewModel.SetThemeCommand}" CommandParameter="Light" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.CurrentTheme, StringFormat='当前：{0}'}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Margin="0,10,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="关于" />
          <TextBlock Margin="0,6,0,0" Text="{Binding ViewModel.AppVersion, StringFormat='版本：{0}'}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Button Content="检查更新" Command="{Binding ViewModel.CheckUpdateCommand}" Margin="0,0,8,0" />
            <ui:Button Content="打开发布页" Command="{Binding ViewModel.OpenDownloadPageCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ViewModel.UpdateStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="本应用不内置模型或聊天；整理由外部 AI 工具通过文件访问或 MCP 执行。" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
