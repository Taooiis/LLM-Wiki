<Page
  x:Class="LLM_Wiki.Views.Pages.AppSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="应用设置"
  d:DataContext="{d:DesignInstance local:AppSettingsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">
  <Page.Resources>
    <dialogs:ConfirmationDialog x:Key="ConfirmDlg" />
    <Style x:Key="ThemeCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource ItemTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Card"
              MinWidth="210"
              Padding="14,12"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="1"
              CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                  <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                  <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource FocusRingBrush}" Visibility="Collapsed" />
                </Grid>
                <ContentPresenter
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  ContentSource="Content"
                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ItemHoverBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ItemSelectedBackgroundBrush}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ItemSelectedBorderBrush}" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource FocusRingBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ItemSelectedForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,24,24,24" MaxWidth="1200" HorizontalAlignment="Stretch">
      <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="应用设置" />
      <TextBlock Margin="0,4,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="管理存储位置、外观和应用信息。" />

      <!-- 存储卡（06§2：CardExpander，头右侧说明“配置影响整个应用。”） -->
      <ui:CardExpander
        Padding="20"
        Background="{DynamicResource CardSurfaceBrush}"
        BorderBrush="{DynamicResource StrokeBrush}"
        BorderThickness="1"
        Icon="{ui:SymbolIcon Symbol=Folder24}"
        IsExpanded="True">
        <ui:CardExpander.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              FontSize="{StaticResource FontSizeSectionTitle}"
              FontWeight="SemiBold"
              Text="存储" />
            <TextBlock
              Grid.Column="1"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="配置影响整个应用。" />
          </Grid>
        </ui:CardExpander.Header>
        <StackPanel Margin="0,8,0,0">
          <TextBlock FontWeight="SemiBold" Text="知识库根目录" />
          <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="该目录下每个子文件夹是一份知识库。切换只更换读取位置，不搬迁、合并或删除原目录文件。" TextWrapping="Wrap" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Text="{Binding ViewModel.WikisDirInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览" Command="{Binding ViewModel.BrowseFolderCommand}" />
          </Grid>
          <!-- 窄窗折行（06§2）：操作按钮换行，状态圈随行 -->
          <WrapPanel Margin="0,8,0,0">
            <ui:Button
              Margin="0,0,8,8"
              Appearance="Primary"
              Command="{Binding ViewModel.ApplyPathCommand}"
              Content="应用路径"
              IsEnabled="{Binding ViewModel.CanApply}" />
            <ui:Button Margin="0,0,12,8" Command="{Binding ViewModel.ResetDefaultCommand}" Content="恢复默认" />
            <ui:ProgressRing
              Width="18"
              Height="18"
              Margin="0,7,8,7"
              IsIndeterminate="True"
              Visibility="{Binding ViewModel.IsValidating, Converter={StaticResource BoolToVis}}" />
          </WrapPanel>
          <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.PathStatus}" TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.WikisDir, StringFormat='当前生效：{0}'}" TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="共享目录的读写权限由 Windows 管理。请避免多台设备同时维护同一份资料；修改者负责重新整理知识。UNC 共享本身不等于只读。" />
        </StackPanel>
      </ui:CardExpander>

      <!-- 外观卡 -->
      <Border Margin="0,16,0,0" Padding="20" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon FontSize="18" Symbol="PaintBrush24" VerticalAlignment="Center" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold" Text="外观" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择适合当前环境的外观，立即生效。" TextWrapping="Wrap" />
          <UniformGrid Columns="2" Margin="0,12,0,0">
            <RadioButton
              Margin="0,0,10,8"
              Click="OnDarkThemeClick"
              GroupName="Theme"
              IsChecked="{Binding ViewModel.IsDarkTheme, Mode=OneWay}"
              Style="{StaticResource ThemeCard}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="深色" />
                <TextBlock FontSize="{StaticResource FontSizeCaption}" Opacity="0.85" Text="适合低光环境，减少视觉干扰。" />
              </StackPanel>
            </RadioButton>
            <RadioButton
              Margin="0,0,0,8"
              Click="OnLightThemeClick"
              GroupName="Theme"
              IsChecked="{Binding ViewModel.IsLightTheme, Mode=OneWay}"
              Style="{StaticResource ThemeCard}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="浅色" />
                <TextBlock FontSize="{StaticResource FontSizeCaption}" Opacity="0.85" Text="适合明亮环境，清晰阅读内容。" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>
          <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.CurrentTheme, StringFormat='当前主题：{0}'}" />
          <!-- 主题持久化失败（06§8）：页内 Warning InfoBar + 重试保存，不弹 Toast -->
          <ui:InfoBar
            Margin="0,10,0,0"
            IsClosable="False"
            IsOpen="True"
            Message="{Binding ViewModel.ThemePersistError, Mode=OneWay}"
            Severity="Warning"
            Visibility="{Binding ViewModel.HasThemePersistError, Converter={StaticResource BoolToVis}}" />
          <ui:Button
            Margin="0,6,0,0"
            Padding="12,4"
            HorizontalAlignment="Left"
            Appearance="Secondary"
            Command="{Binding ViewModel.RetrySaveThemeCommand}"
            Content="重试保存"
            Visibility="{Binding ViewModel.HasThemePersistError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>

      <!-- 关于卡 -->
      <Border Margin="0,16,0,0" Padding="20" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon FontSize="18" Symbol="Info24" VerticalAlignment="Center" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSectionTitle}" FontWeight="SemiBold" Text="关于" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0" Text="{Binding ViewModel.AppVersion, StringFormat='版本：{0}'}" />
          <!-- 窄窗折行（06§2）：按钮行换行，更新状态另起一行 -->
          <WrapPanel Margin="0,10,0,0">
            <ui:Button
              Margin="0,0,8,8"
              Command="{Binding ViewModel.CheckUpdateCommand}"
              Content="检查更新"
              IsEnabled="{Binding ViewModel.IsCheckingUpdate, Converter={StaticResource InverseBool}}" />
            <ui:Button Margin="0,0,8,8" Command="{Binding ViewModel.OpenDownloadPageCommand}" Content="打开发布页" />
            <ui:Button Margin="0,0,12,8" Command="{Binding ViewModel.OpenHelpAsyncCommand}" Content="查看使用帮助" />
          </WrapPanel>
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.UpdateStatus}" TextWrapping="Wrap" />
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="LLM Wiki · 本地资料与知识工作台" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
