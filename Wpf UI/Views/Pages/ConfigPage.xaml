<Page
  x:Class="LLM_Wiki.Views.Pages.ConfigPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="配置"
  d:DataContext="{d:DesignInstance local:ConfigPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <ScrollViewer>
    <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="900">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 标题 -->
      <TextBlock Grid.Row="0"
                 Style="{StaticResource PageTitleText}"
                 Text="配置" />

      <!-- 存储路径配置 -->
      <Border Grid.Row="1"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              Padding="20"
              Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitleText}" Text="存储路径" />
          <TextBlock Text="知识库文件存储位置，可设为盘符路径或局域网共享（UNC）"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Margin="0,0,0,12" />

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 当前路径 -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Text="{Binding ViewModel.WikisDir, StringFormat='当前: {0}'}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,0,0,8" />

            <!-- 输入框行 -->
            <ui:TextBox Grid.Row="1" Grid.Column="0"
                        x:Name="WikisDirInput"
                        Margin="0,0,8,0"
                        Text="{Binding ViewModel.WikisDirInput, Mode=TwoWay}"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />

            <ui:Button Grid.Row="1" Grid.Column="1"
                       Content="浏览"
                       Click="OnBrowseClick"
                       Margin="0,0,8,0"
                       Icon="Folder24" />

            <ui:Button Grid.Row="1" Grid.Column="2"
                       Content="保存"
                       Command="{Binding ViewModel.SaveWikisDirCommand}"
                       IsEnabled="{Binding ViewModel.IsPathValid}"
                       Margin="0,0,0,0"
                       Icon="Save24" />

            <!-- 错误提示 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding ViewModel.PathErrorMessage}"
                       Foreground="{DynamicResource TextFillColorDangerBrush}"
                       Margin="0,4,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- purpose.md 编辑 -->
      <Border Grid.Row="2"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              Padding="20">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitleText}" Text="purpose.md" />
          <TextBlock Text="知识库目标 / 关键问题 / 研究范围"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Margin="0,0,0,12" />
          <ui:TextBox x:Name="PurposeEditor"
                      MinHeight="120"
                      Text="{Binding ViewModel.PurposeContent, Mode=TwoWay}"
                      AcceptsReturn="True"
                      TextWrapping="Wrap"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource ApplicationBackgroundBrush}"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <ui:Button Content="保存"
                     Command="{Binding ViewModel.SavePurposeCommand}"
                     CommandParameter="{Binding ElementName=PurposeEditor, Path=Text}"
                     Margin="0,8,0,0"
                     Icon="Save24" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>