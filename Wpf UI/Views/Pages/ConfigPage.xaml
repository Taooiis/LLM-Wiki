<Page
  x:Class="LLM_Wiki.Views.Pages.ConfigPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="ConfigPage"
  d:DataContext="{d:DesignInstance local:ConfigPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <TextBlock Grid.Row="0" FontSize="20" FontWeight="Medium" Text="配置" Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,0,12">

        <!-- 存储路径配置 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="6"
          Padding="16"
          Margin="0,0,0,16">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="存储路径" Margin="0,0,0,12" />
            <TextBlock Text="知识库文件存储在本地目录，可设为盘符路径或局域网共享（UNC）。" Margin="0,0,0,8" />

            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <ui:TextBox
                Grid.Row="0" Grid.Column="0"
                x:Name="WikisDirInput"
                Margin="0,0,8,8"
                Text="{Binding ViewModel.WikisDirInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />

              <ui:Button
                Grid.Row="0" Grid.Column="1"
                Content="浏览"
                Click="OnBrowseClick"
                Margin="0,0,8,8"
                Icon="Fluent24" />

              <ui:Button
                Grid.Row="1" Grid.Column="0"
                Content="保存路径"
                Command="{Binding ViewModel.SaveWikisDirCommand}"
                IsEnabled="{Binding ViewModel.IsPathValid}"
                Margin="0,0,8,0"
                Icon="Fluent24" />

              <ui:Button
                Grid.Row="1" Grid.Column="1"
                Content="恢复默认"
                Command="{Binding ViewModel.ResetWikisDirCommand}"
                Margin="0,0,8,0"
                Icon="Fluent24" />

              <TextBlock
                Grid.Row="2" Grid.ColumnSpan="2"
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorDangerBrush}"
                Text="{Binding ViewModel.PathErrorMessage}"
                TextWrapping="Wrap" />

              <TextBlock
                Grid.Row="3" Grid.ColumnSpan="2"
                Margin="0,8,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.WikisDir, StringFormat='当前路径: {0}'}"
                TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- purpose.md 编辑 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="6"
          Padding="16"
          Margin="0,0,0,16">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="purpose.md（知识库目标 / 关键问题 / 研究范围）" Margin="0,0,0,8" />
            <ui:TextBox
              x:Name="PurposeEditor"
              MinHeight="140"
              Text="{Binding ViewModel.PurposeContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              VerticalScrollBarVisibility="Auto"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button
              Content="保存 purpose.md"
              Command="{Binding ViewModel.SavePurposeCommand}"
              CommandParameter="{Binding ElementName=PurposeEditor, Path=Text}"
              Margin="0,8,0,0"
              Icon="Fluent24" />
          </StackPanel>
        </Border>

        <!-- schema.md 编辑 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="6"
          Padding="16">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="schema.md（结构规则）" Margin="0,0,0,8" />
            <ui:TextBox
              x:Name="SchemaEditor"
              MinHeight="140"
              Text="{Binding ViewModel.SchemaContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              VerticalScrollBarVisibility="Auto"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button
              Content="保存 schema.md"
              Command="{Binding ViewModel.SaveSchemaCommand}"
              CommandParameter="{Binding ElementName=SchemaEditor, Path=Text}"
              Margin="0,8,0,0"
              Icon="Fluent24" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
