<Page
  x:Class="LLM_Wiki.Views.Pages.GuidePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="GuidePage"
  d:DataContext="{d:DesignInstance local:GuidePage, IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <TextBlock Grid.Row="0" FontSize="20" FontWeight="Medium" Text="小白指南（分类速查）" Margin="0,0,0,16" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,0,12">

        <!-- 快速上手 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,12"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="一、快速上手三步" Margin="0,0,0,8" />
            <TextBlock Text="1. 新建知识库 → 源文档页上传 .md → 配置页填写目标和规则。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="2. 工作流页先做第 1 步接入（边界说明进 Agent 配置）→ 再生成 Ingest 等提示词 → 粘贴执行 → 回面板刷新看 wiki/ 成果。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="3. 双击程序启动，退出双击关闭。" Margin="0,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 日常使用 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,12"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="二、日常使用：文档与编辑" Margin="0,0,0,8" />
            <TextBlock Text="源文档页：＋新建文档 / 上传 / 点编辑弹窗修改 / 删除。只收 .md/.txt。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="改了哪些不用记：顶部待处理变更自动列出，勾选 → 生成选中 Ingest → 执行完标记已处理。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="目录浏览页：刷新目录树，点文件名弹窗编辑，下方同步预览。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="弹窗通用操作：改后标题栏 ● 未保存提醒；Ctrl+S 保存；Esc 关闭（未保存会确认）。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="重要规则：源文档的新增/修改/删除只写文件并自动记入 wiki/log.md，wiki 页面不会自己变——保存后按提醒去工作流页重新 Ingest 该文档。" Margin="0,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 管理与配置 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,12"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="三、管理与配置" Margin="0,0,0,8" />
            <TextBlock Text="存储路径：点浏览（直达桌面/文档/程序目录、地址栏直达）或手填，点更改路径立即生效；旧文件不会自动搬移，需手动复制到新位置。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="配置页：点 purpose.md / schema.md 旁编辑，弹窗改目标规则，保存即生效。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="目录：库名/ 下 purpose.md、schema.md、raw/sources/、wiki/（index/log/overview/entities/concepts/...）。" Margin="0,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- AI 协作 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,12"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="四、AI 协作：工作流与边界说明" Margin="0,0,0,8" />
            <TextBlock Text="第一步先接入：点生成边界说明 → 复制 → 粘贴进 Agent 配置（全局 AGENTS.md 等），新会话可直接读库；换库或大改后重新生成覆盖。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="工作流页：Ingest（填源文件名，支持批量留空全选）/ Query（填问题）/ Lint / Compare / 变更文档 Ingest（只处理新增/改动/删除）→ 生成 → 一键复制 → 粘贴到已接入的 AI 工具执行 → 回来刷新。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="不开面板可用 prompts/ 下离线模板（ingest/query/lint/compare/context）。" Margin="0,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 运行与网络 -->
        <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16"
          Margin="0,0,0,12"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="五、运行与网络" Margin="0,0,0,8" />
            <TextBlock Text="改完代码行为没变：先 stop 再启动，防止旧服务占着 8765 端口。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="局域网：同一 WiFi 下用打印的局域网地址（如 http://192.168.x.x:8765）在手机/另一电脑打开；防火墙弹窗点允许；仅可信网络使用。" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock Text="多电脑（库在 A，B 要用）：B 直接用浏览器打开 A 的面板可看可改；B 想自己跑 AI，A 把 wikis 文件夹共享，B 面板点浏览 → 局域网一路点选共享，路径自动填入。双方别同时改同一文件。" Margin="0,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
