<Page
  x:Class="LLM_Wiki.Views.Pages.KbSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="知识库设置"
  d:DataContext="{d:DesignInstance local:KbSettingsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="820"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">
  <Page.Resources>
    <dialogs:UnsavedChangesDialog x:Key="UnsavedDlg" />
    <dialogs:ConfirmationDialog x:Key="ConfirmDlg" />
  </Page.Resources>

  <Grid Margin="{StaticResource PageContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="知识库设置" />
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.SelectedKb, StringFormat='当前库：{0}'}" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="基本信息">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" MaxWidth="860" HorizontalAlignment="Left">
            <Border Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ViewModel.SelectedKb}" />
                <TextBlock Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.KbPath}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ViewModel.DirectoryStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <ui:Button Content="打开文件夹" Icon="FolderOpen24" Command="{Binding ViewModel.OpenFolderCommand}" Margin="0,0,8,0" />
                  <ui:Button Content="复制路径" Icon="Copy24" Command="{Binding ViewModel.CopyPathCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Visibility="{Binding ViewModel.RuleNeedsReview, Converter={StaticResource BoolToVis}}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Text="规则已更新，已有知识尚未按新规则核对。" />
                <ui:Button Grid.Column="1" Content="确认已按新规则核对" Command="{Binding ViewModel.AcknowledgeRulesCommand}" Appearance="Primary" />
              </Grid>
            </Border>

            <Expander Margin="0,16,0,0" Header="危险操作">
              <Border Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="永久删除此知识库" />
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="将永久删除全部资料、知识文件、任务状态和库内回收站，无法通过本应用恢复。删除前需停止绑定服务并确认没有未保存编辑。" />
                  <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel.SelectedKb, StringFormat='请输入库名以确认：{0}'}" />
                  <ui:TextBox Margin="0,6,0,0" Width="320" HorizontalAlignment="Left" Text="{Binding ViewModel.DeleteConfirmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="永久删除此知识库" Click="OnDeleteClick" IsEnabled="{Binding ViewModel.CanDelete}" />
                </StackPanel>
              </Border>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="目标与结构">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="目标与结构直接保存在库内 Markdown 文件；保存后已有知识尚未按新规则核对，规则提醒会持续保留，直到你显式确认。" />

            <Border Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="目标与边界  purpose.md" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="这个知识库为谁服务、回答哪些问题、哪些内容不收录。" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.PurposeStatus}" />
                    <ui:Button Content="载入默认模板" Command="{Binding ViewModel.LoadDefaultPurposeCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="保存目标" Appearance="Primary" Command="{Binding ViewModel.SavePurposeCommand}" />
                  </StackPanel>
                </Grid>
                <TextBox
                  Height="220"
                  Margin="0,12,0,0"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  FontFamily="Consolas"
                  Text="{Binding ViewModel.PurposeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="组织规则  schema.md" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="知识如何分类、如何标注来源、如何建立互链。" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.SchemaStatus}" />
                    <ui:Button Content="载入默认模板" Command="{Binding ViewModel.LoadDefaultSchemaCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="保存规则" Appearance="Primary" Command="{Binding ViewModel.SaveSchemaCommand}" />
                  </StackPanel>
                </Grid>
                <TextBox
                  Height="300"
                  Margin="0,12,0,0"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  FontFamily="Consolas"
                  Text="{Binding ViewModel.SchemaDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Page>
