<Page
  x:Class="LLM_Wiki.Views.Pages.KbSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="知识库设置"
  d:DataContext="{d:DesignInstance local:KbSettingsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="820"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource ItemTextBrush}"
  Foreground="{DynamicResource ItemTextBrush}"
  mc:Ignorable="d">
  <Page.Resources>
    <dialogs:UnsavedChangesDialog x:Key="UnsavedDlg" />
    <dialogs:ConfirmationDialog x:Key="ConfirmDlg" />

    <!--  状态徽章小圆点（05§2）：未修改/保存中=SecondaryText，未保存=Warning，失败/冲突=Danger  -->
    <Style x:Key="PurposeDotStyle" TargetType="Border">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ViewModel.PurposeState}" Value="Dirty">
          <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ViewModel.PurposeState}" Value="Failed">
          <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ViewModel.PurposeState}" Value="Conflict">
          <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SchemaDotStyle" TargetType="Border">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SecondaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ViewModel.SchemaState}" Value="Dirty">
          <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ViewModel.SchemaState}" Value="Failed">
          <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ViewModel.SchemaState}" Value="Conflict">
          <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Margin="{StaticResource PageContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="知识库设置" />
      <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.SelectedKb, StringFormat='当前库：{0}'}" />
    </StackPanel>

    <!--  WPF-UI 4.3.0 无 ui:TabControl 类型：官方主题以隐式样式（Controls/TabControl/TabControl.xaml）接管原生 TabControl/TabItem  -->
    <TabControl Grid.Row="1" SelectedIndex="1">
      <TabItem Header="基本信息">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12" MaxWidth="860" HorizontalAlignment="Left">
            <!--  知识库管理：列表勾选 + 批量删除，替代原先藏在“危险操作”里的单库删除  -->
            <Border Padding="16" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid>
                  <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="知识库管理" />
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Content="全选 / 取消全选" Command="{Binding ViewModel.ToggleSelectAllCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Primary" Click="OnCreateKb" Content="新建知识库" Icon="Add24" />
                  </StackPanel>
                </Grid>
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="勾选一个或多个知识库后批量删除；删除不可恢复。删除当前库前需先保存或放弃草稿。" TextWrapping="Wrap" />

                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ViewModel.KbRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" Padding="12,8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                            <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                              <TextBlock FontSize="11" Foreground="White" Text="当前" />
                            </Border>
                          </StackPanel>
                          <ui:Button
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            Command="{Binding DataContext.ViewModel.SwitchKbCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}"
                            Content="切换"
                            IsEnabled="{Binding IsNotCurrent}" />
                          <ui:Button
                            Grid.Column="3"
                            Command="{Binding DataContext.ViewModel.DeleteKbRowCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}"
                            Content="删除" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="还没有知识库，点击右上角“新建知识库”开始。" TextWrapping="Wrap" Visibility="{Binding ViewModel.KbRows.Count, Converter={StaticResource CountToEmptyVis}}" />

                <ui:InfoBar
                  Margin="0,10,0,0"
                  IsClosable="False"
                  IsOpen="{Binding ViewModel.DeleteBlockedByDraft, Mode=OneWay}"
                  Message="“目标与结构”页签中存在未保存的草稿；请先保存或放弃更改，再删除当前知识库。"
                  Severity="Warning"
                  Title="请先处理未保存的更改" />

                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.SelectionSummary}" />
                  <ui:Button Appearance="Danger" Command="{Binding ViewModel.DeleteSelectedKbsCommand}" Content="删除所选" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ViewModel.SelectedKb}" />
                <TextBlock Margin="0,6,0,0" FontFamily="Consolas" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.KbPath}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.DirectoryStatus}" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                  <ui:Button Margin="0,0,8,0" Command="{Binding ViewModel.OpenFolderCommand}" Content="打开文件夹" Icon="FolderOpen24" />
                  <ui:Button Command="{Binding ViewModel.CopyPathCommand}" Content="复制路径" Icon="Copy24" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="目标与结构">
        <ScrollViewer x:Name="RulesScroll" SizeChanged="OnRulesSizeChanged" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <!--  规则提醒（05§2/§8.1）：持久 InfoBar，置于规则编辑区顶部；“稍后处理”只折叠当前版本提醒  -->
            <StackPanel MaxWidth="1280" Visibility="{Binding ViewModel.RuleNeedsReview, Converter={StaticResource BoolToVis}}">
              <ui:InfoBar
                IsClosable="False"
                IsOpen="{Binding ViewModel.RuleNeedsReview, Mode=OneWay}"
                Message="稍后处理只折叠当前版本提醒，不代表已完成核对；已有知识尚未按新规则核对。"
                Severity="Warning"
                Title="规则已更新，已有知识尚未按新规则核对" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="稍后处理" Command="{Binding ViewModel.IgnoreRulesCommand}" Margin="0,0,8,0" />
                <ui:Button Content="确认已按新规则核对" Appearance="Primary" Command="{Binding ViewModel.AcknowledgeRulesCommand}" />
              </StackPanel>
            </StackPanel>

            <Grid x:Name="RulesGrid" MaxWidth="1280" HorizontalAlignment="Stretch" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PurposeColumn" Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="RulesGapColumn" Width="16" />
                <ColumnDefinition x:Name="SchemaColumn" Width="*" MinWidth="320" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="RulesGapRow" Height="0" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border x:Name="PurposeCard" Grid.Column="0" Padding="20" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{StaticResource PurposeDotStyle}" Margin="0,1,6,0" />
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="目标与边界  purpose.md" />
                    </StackPanel>
                    <TextBlock Margin="14,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.PurposeStatus}" />
                    <TextBlock Margin="14,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="这个知识库为谁服务、回答哪些问题、哪些内容不收录。" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox
                    Height="380"
                    Margin="0,12,0,0"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    Text="{Binding ViewModel.PurposeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                  <ui:InfoBar
                    Margin="0,10,0,0"
                    IsClosable="False"
                    IsOpen="{Binding ViewModel.PurposeConflict, Mode=OneWay}"
                    Message="purpose.md 在磁盘上已被其他程序修改，本次未写入；当前草稿仍保留在编辑区。"
                    Severity="Error"
                    Title="磁盘版本已变化" />
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding ViewModel.PurposeConflict, Converter={StaticResource BoolToVis}}">
                    <ui:Button Content="载入磁盘版本" Command="{Binding ViewModel.LoadDiskPurposeCommand}" />
                    <ui:Button Content="另存草稿副本" Command="{Binding ViewModel.CopyPurposeDraftCopyCommand}" Margin="8,0,0,0" />
                  </StackPanel>
                  <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource DangerBrush}"
                    Text="{Binding ViewModel.PurposeError}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ViewModel.HasPurposeError, Converter={StaticResource BoolToVis}}" />
                  <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Content="载入默认模板" Command="{Binding ViewModel.LoadDefaultPurposeCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="保存目标" Appearance="Primary" Command="{Binding ViewModel.SavePurposeCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="SchemaCard" Grid.Column="2" Padding="20" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{StaticResource SchemaDotStyle}" Margin="0,1,6,0" />
                      <TextBlock FontSize="18" FontWeight="SemiBold" Text="组织规则  schema.md" />
                    </StackPanel>
                    <TextBlock Margin="14,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ViewModel.SchemaStatus}" />
                    <TextBlock Margin="14,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="知识如何分类、如何标注来源、如何建立互链。" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox
                    Height="380"
                    Margin="0,12,0,0"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    Text="{Binding ViewModel.SchemaDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                  <ui:InfoBar
                    Margin="0,10,0,0"
                    IsClosable="False"
                    IsOpen="{Binding ViewModel.SchemaConflict, Mode=OneWay}"
                    Message="schema.md 在磁盘上已被其他程序修改，本次未写入；当前草稿仍保留在编辑区。"
                    Severity="Error"
                    Title="磁盘版本已变化" />
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding ViewModel.SchemaConflict, Converter={StaticResource BoolToVis}}">
                    <ui:Button Content="载入磁盘版本" Command="{Binding ViewModel.LoadDiskSchemaCommand}" />
                    <ui:Button Content="另存草稿副本" Command="{Binding ViewModel.CopySchemaDraftCopyCommand}" Margin="8,0,0,0" />
                  </StackPanel>
                  <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource DangerBrush}"
                    Text="{Binding ViewModel.SchemaError}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ViewModel.HasSchemaError, Converter={StaticResource BoolToVis}}" />
                  <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Content="载入默认模板" Command="{Binding ViewModel.LoadDefaultSchemaCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="保存规则" Appearance="Primary" Command="{Binding ViewModel.SaveSchemaCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="目标与结构直接保存在库内 Markdown 文件；保存后已有知识尚未按新规则核对，规则提醒会持续保留，直到你显式确认。" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Page>
