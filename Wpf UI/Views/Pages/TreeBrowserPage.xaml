<Page
  x:Class="LLM_Wiki.Views.Pages.TreeBrowserPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:LLM_Wiki.Controls"
  xmlns:helpers="clr-namespace:LLM_Wiki.Helpers"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  Title="TreeBrowserPage"
  d:DataContext="{d:DesignInstance local:TreeBrowserPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <dialogs:UnsavedChangesDialog x:Key="UnsavedDlg" />
    <helpers:FileNodeIconConverter x:Key="FileNodeIcon" />
    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  </Page.Resources>

  <!-- 根布局：各区自带滚动，撑满视口高度 -->
  <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="1100">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 + 工具栏（03§2：刷新目录 / 展开全部 / 折叠全部） -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource PageTitleText}" Margin="0" Text="目录浏览" />
      <TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        Margin="16,0,0,0"
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="浏览当前知识库的 Wiki 页面和相关资料。"
        TextWrapping="Wrap" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button
          Content="刷新目录"
          Command="{Binding ViewModel.RefreshTreeCommand}"
          Margin="0,0,8,0"
          Icon="ArrowClockwise24" />
        <ui:Button
          Content="展开全部"
          Command="{Binding ViewModel.ExpandAllCommand}"
          Margin="0,0,8,0"
          Icon="ChevronDown24" />
        <ui:Button
          Content="折叠全部"
          Command="{Binding ViewModel.CollapseAllCommand}"
          Icon="ChevronRight24" />
      </StackPanel>
    </Grid>

    <!-- 内容区：左树 + 右文档工作区（03§2） -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：当前库 + 搜索 + 目录树（03§3） -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 当前知识库名称持续可见 -->
        <TextBlock Grid.Row="0"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="8,0,8,2"
                   Text="当前知识库" />
        <TextBlock Grid.Row="1"
                   FontSize="{StaticResource FontSizeBody}"
                   FontWeight="SemiBold"
                   Margin="8,0,8,8"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding ViewModel.SelectedKb, TargetNullValue='未选择'}" />

        <!-- 搜索：过滤目录树，保留父级路径（03§3） -->
        <ui:TextBox
          Grid.Row="2"
          Margin="8,0,8,8"
          PlaceholderText="搜索目录或文件…"
          Icon="Search24"
          Text="{Binding ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="3">
          <!-- 错误态：目录不可访问 → 说明 + 重试，不用空树冒充（03§6） -->
          <controls:EmptyState
            Icon="⚠️"
            Title="目录不可访问"
            Description="{Binding ViewModel.LoadError}"
            Visibility="{Binding ViewModel.HasLoadError, Converter={StaticResource BoolToVis}}">
            <controls:EmptyState.ActionContent>
              <ui:Button
                Content="重试"
                Appearance="Primary"
                Command="{Binding ViewModel.RefreshTreeCommand}" />
            </controls:EmptyState.ActionContent>
          </controls:EmptyState>

          <Grid Visibility="{Binding ViewModel.HasLoadError, Converter={StaticResource InverseBoolToVis}}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TreeView
              x:Name="FolderTree"
              Grid.Row="0"
              ItemsSource="{Binding ViewModel.TreeItems, Mode=OneWay}"
              Background="Transparent"
              BorderThickness="0"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              SelectedItemChanged="FolderTree_SelectedItemChanged">
              <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </TreeView.ItemsPanel>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                  <Setter Property="Padding" Value="4,3" />
                  <Setter Property="ItemsPanel">
                    <Setter.Value>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding VisibleChildren}">
                  <!-- 树行：类型图标 + 名称；选中态低饱和蓝底 + 左侧 2px 蓝线（03§3） -->
                  <Border x:Name="RowRoot"
                          Padding="6,3"
                          Margin="0,1"
                          CornerRadius="4"
                          BorderThickness="2,1,1,1"
                          BorderBrush="Transparent"
                          Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon
                        FontSize="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                        Symbol="{Binding IconKey, Converter={StaticResource FileNodeIcon}}" />
                      <TextBlock
                        Text="{Binding Name}"
                        FontSize="{StaticResource FontSizeBody}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                      <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                      <Setter TargetName="RowRoot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                  </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <!-- 目录项计数（03§2 布局） -->
            <TextBlock
              Grid.Row="1"
              Margin="8,6,8,0"
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Text="{Binding ViewModel.VisibleCount, StringFormat='目录项 {0}'}" />
          </Grid>
        </Grid>
      </Grid>

      <!-- 右侧：复用文档工作区（预览/编辑/只读/未保存保护，03§4） -->
      <controls:DocumentWorkspace
        Grid.Column="1"
        Margin="8,0,0,0"
        DataContext="{Binding ViewModel.Workspace}" />
    </Grid>
  </Grid>
</Page>
