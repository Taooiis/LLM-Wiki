<Page
  x:Class="LLM_Wiki.Views.Pages.TreeBrowserPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="TreeBrowserPage"
  d:DataContext="{d:DesignInstance local:TreeBrowserPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="1100">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 + 工具栏 -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource PageTitleText}" Text="目录浏览" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock
          VerticalAlignment="Center"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding ViewModel.SelectedKb, StringFormat='当前库: {0}'}"
          Margin="0,0,12,0" />
      </StackPanel>
    </Grid>

    <!-- 内容区：左树 + 右预览 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：目录树 -->
      <Border Grid.Column="0" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="0,0,1,0">
        <TreeView
          x:Name="FolderTree"
          ItemsSource="{Binding ViewModel.TreeItems, Mode=OneWay}"
          Background="Transparent"
          BorderThickness="0"
          SelectedItemChanged="FolderTree_SelectedItemChanged">
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Margin="4,2" />
                <TextBlock
                  Text="{Binding Type}"
                  FontSize="{StaticResource FontSizeCaption}"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <!-- 右侧：预览/编辑 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          Grid.Row="0"
          FontSize="{StaticResource FontSizeBody}"
          FontWeight="SemiBold"
          Margin="0,0,0,4"
          Text="{Binding ViewModel.SelectedFilePath, StringFormat='文件: {0}', TargetNullValue='请选择文件'}"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:TextBox
          Grid.Row="1"
          x:Name="PreviewEditor"
          Margin="0,0,0,8"
          Text="{Binding ViewModel.PreviewContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
          IsReadOnly="{Binding ViewModel.IsPreviewReadOnly}"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
          <ui:Button
            Content="保存"
            Command="{Binding ViewModel.SavePreviewCommand}"
            CommandParameter="{Binding ElementName=PreviewEditor, Path=Text}"
            Margin="0,0,8,0"
            Icon="Save24"
            IsEnabled="{Binding ViewModel.IsEditMode}" />
          <ui:Button
            Content="关闭"
            Command="{Binding ViewModel.ClosePreviewCommand}"
            Icon="Dismiss24" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
