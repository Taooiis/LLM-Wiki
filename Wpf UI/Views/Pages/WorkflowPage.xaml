<Page
  x:Class="LLM_Wiki.Views.Pages.WorkflowPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:helpers="clr-namespace:LLM_Wiki.Helpers"
  xmlns:controls="clr-namespace:LLM_Wiki.Controls"
  Title="WorkflowPage"
  d:DataContext="{d:DesignInstance local:WorkflowPage, IsDesignTimeCreatable=False}"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <helpers:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroVis" />
    <helpers:CountToEmptyVisibilityConverter x:Key="CountToEmptyVis" />

    <!-- 卡片统一模板（设计文档 04§3：编号+标题+说明+输入+生成/复制+可折叠预览） -->
    <DataTemplate x:Key="CardTemplate">
      <Border
        Padding="16"
        Margin="8,0,8,16"
        CornerRadius="10"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
        BorderThickness="1">
        <StackPanel>
          <!-- 头行：编号徽标 + 标题 + 状态 + 操作 -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Border
                Width="26"
                Height="26"
                CornerRadius="6"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="13"
                  FontWeight="Bold"
                  Foreground="White"
                  Text="{Binding Index}" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock
                  FontSize="{StaticResource FontSizeCaption}"
                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                  Text="{Binding StatusText}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <ui:Button
                Content="生成"
                Appearance="Primary"
                Margin="0,0,8,0"
                IsEnabled="{Binding CanCopy}"
                Command="{Binding ViewModel.GenerateCardCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                CommandParameter="{Binding Title}" />
              <ui:Button
                Content="复制"
                Appearance="Secondary"
                Icon="Copy24"
                IsEnabled="{Binding CanCopy}"
                Command="{Binding ViewModel.CopyPromptCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                CommandParameter="{Binding Title}" />
            </StackPanel>
          </Grid>

          <!-- 一句话用途说明 -->
          <TextBlock
            Margin="0,8,0,0"
            FontSize="{StaticResource FontSizeBody}"
            Text="{Binding Description}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

          <!-- 参数输入（批量 Ingest / Query / Compare） -->
          <ui:TextBox
            Margin="0,10,0,0"
            Visibility="{Binding ShowInput, Converter={StaticResource BoolToVis}}"
            PlaceholderText="{Binding InputPlaceholder}"
            Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

          <!-- 可折叠提示词预览（设计文档 04§5：不撑满卡片，可滚动、可复制） -->
          <Expander
            Margin="0,10,0,0"
            IsExpanded="False"
            HorizontalAlignment="Stretch">
            <Expander.Header>
              <TextBlock
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ContentSummary}" />
            </Expander.Header>
            <ui:TextBox
              MinHeight="100"
              MaxHeight="220"
              Margin="0,6,0,0"
              Text="{Binding PromptContent, Mode=OneWay}"
              FontFamily="Consolas"
              FontSize="12"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              VerticalScrollBarVisibility="Auto"
              IsReadOnly="True" />
          </Expander>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Margin="{StaticResource PageContentMargin}" MaxWidth="1280">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 + 当前库路径 + 刷新 -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource PageTitleText}" Text="工作流" />
        <TextBlock
          Margin="0,-8,0,0"
          Text="为 AI Agent 生成标准化任务指令，维护和检查知识库。"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
        <TextBlock
          VerticalAlignment="Center"
          Margin="0,0,12,0"
          FontSize="{StaticResource FontSizeCaption}"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          TextTrimming="CharacterEllipsis"
          ToolTip="{Binding ViewModel.KbPath}"
          Text="{Binding ViewModel.KbPathText, StringFormat='当前库：{0}'}" />
        <ui:Button
          Content="刷新工作流"
          Appearance="Secondary"
          Icon="ArrowClockwise24"
          Command="{Binding ViewModel.RefreshWorkflowCommand}" />
      </StackPanel>
    </Grid>

    <!-- 待处理变更状态行（设计文档 04§2） -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="当前待处理变更：" />
          <Run Text="{Binding ViewModel.PendingCount, Mode=OneWay}" FontWeight="Bold"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <Run Text=" 项" />
        </TextBlock>
        <ui:Button
          Margin="16,0,0,0"
          Content="从变更列表导入"
          Appearance="Secondary"
          Command="{Binding ViewModel.ImportChangesCommand}" />
      </StackPanel>
    </Grid>

    <!-- 卡片区：1-6 双列网格 + Clean 横跨（设计文档 04§2、§8） -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <Grid>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding ViewModel.MainCards, Mode=OneWay}" ItemTemplate="{StaticResource CardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <!-- ⑦ Clean 横跨双列；无库/未构建时不渲染空卡片 -->
          <ContentControl
            Content="{Binding ViewModel.CleanCard, Mode=OneWay}"
            ContentTemplate="{StaticResource CardTemplate}">
            <ContentControl.Style>
              <Style TargetType="ContentControl">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ViewModel.CleanCard}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </StackPanel>

        <!-- 未选择知识库：引导回首页（设计文档 04§7 空状态） -->
        <controls:EmptyState
          Icon="🧭"
          Title="还没有选择知识库"
          Description="请先在首页选择或创建一个知识库，工作流卡片会按当前库自动生成。"
          VerticalAlignment="Center"
          Visibility="{Binding ViewModel.MainCards.Count, Converter={StaticResource CountToEmptyVis}}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
