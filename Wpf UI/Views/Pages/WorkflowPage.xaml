<Page
  x:Class="LLM_Wiki.Views.Pages.WorkflowPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="WorkflowPage"
  d:DataContext="{d:DesignInstance local:WorkflowPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 + 当前库 -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" FontSize="20" FontWeight="Medium" Text="工作流 - 提示词生成" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock
          Text="{Binding ViewModel.KbPath, StringFormat='库: {0}'}"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Ingest 文件名输入 -->
    <Grid Grid.Row="0" Grid.RowSpan="1" Margin="0,40,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock
        Grid.Column="0"
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        FontSize="13"
        Text="Ingest 文件名：" />
      <ui:TextBox
        Grid.Column="1"
        Margin="8,0,0,0"
        Text="{Binding ViewModel.IngestFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        PlaceholderText="如 xxx.md，多个用逗号分隔；留空=全部源文档"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />
    </Grid>

    <!-- 提示词卡片列表 -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ViewModel.PromptCards, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              Padding="16"
              Margin="0,0,0,12"
              BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
              BorderThickness="1">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Grid.Column="0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding Title}" />
                  <ui:Button
                    Grid.Column="1"
                    Content="复制"
                    Command="{Binding DataContext.CopyPromptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Title}"
                    Margin="8,0,0,0"
                    Icon="Fluent24" />
                </Grid>
                <TextBlock
                  Margin="0,4,0,8"
                  Text="{Binding Description}"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" />
                <TextBox
                  MinHeight="120"
                  MaxHeight="240"
                  Text="{Binding PromptContent, Mode=OneWay}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  IsReadOnly="True"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Page>
