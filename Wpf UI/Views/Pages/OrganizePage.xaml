<Page
  x:Class="LLM_Wiki.Views.Pages.OrganizePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dialogs="clr-namespace:LLM_Wiki.Views.Dialogs"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="整理"
  d:DataContext="{d:DesignInstance local:OrganizePage, IsDesignTimeCreatable=False}"
  d:DesignHeight="800"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">
  <Page.Resources>
    <dialogs:ConfirmationDialog x:Key="ConfirmDlg" />
    <dialogs:UnsavedChangesDialog x:Key="UnsavedDlg" />
    <Style x:Key="PillText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StepCircle" TargetType="Border">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Page.Resources>

  <Grid Margin="24,24,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 本机执行结束提醒：Agent 结束事件驱动，保留到核对完成（03§11 L143） -->
    <ui:InfoBar
      Grid.Row="1"
      Margin="0,0,0,10"
      IsOpen="{Binding ViewModel.AgentEndedNotice, Converter={StaticResource BoolToVis}}"
      IsClosable="False"
      Title="外部程序已结束，请核对结果"
      Message="{Binding ViewModel.AgentRunStatus}"
      Severity="Informational" />

    <!-- 页头 -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="整理" />
          <TextBlock
            Margin="14,10,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="把资料变更整理成可追溯的知识。"
            TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.PendingSummary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
          <Run Text="当前知识库：" /><Run Text="{Binding ViewModel.SelectedKb, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <ui:Button Content="刷新待整理清单" Icon="ArrowSync24" Command="{Binding ViewModel.RefreshPendingCommand}" Margin="0,0,8,0" />
          <ui:Button Content="更多 ▾" Click="OnMoreClick" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- 规则更新提醒 -->
    <Border
      Grid.Row="2"
      Margin="0,0,0,10"
      Padding="12"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource WarningBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Visibility="{Binding ViewModel.RuleNeedsReview, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Text="规则已更新，已有知识尚未按新规则核对。旧指令不能当作当前指令复制；任务核对完成后请显式确认。" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button Content="稍后处理" Click="OnIgnoreRulesClick" Margin="0,0,8,0" />
          <ui:Button Content="确认已按新规则核对" Click="OnAcknowledgeRulesClick" Appearance="Primary" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 三类任务输入 -->
    <TabControl Grid.Row="3" SelectedIndex="{Binding ViewModel.ActiveTab, Mode=TwoWay}" Margin="0,0,0,10">
      <TabItem Header="更新知识">
        <StackPanel Margin="12,10,12,10">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock VerticalAlignment="Center" Text="处理范围" Margin="0,0,8,0" />
            <ComboBox MinWidth="190" MinHeight="32" ItemsSource="{Binding ViewModel.ScopeOptions}" SelectedItem="{Binding ViewModel.Scope, Mode=TwoWay}" />
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.TransportHint}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Foreground="{DynamicResource WarningBrush}" Text="{Binding ViewModel.McpHint}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="提问分析">
        <StackPanel Margin="12,10,12,10">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="类型" Margin="0,0,8,0" />
            <ComboBox MinWidth="160" MinHeight="32" ItemsSource="{Binding ViewModel.AskTypes}" SelectedItem="{Binding ViewModel.AskType, Mode=TwoWay}" />
          </StackPanel>
          <ui:TextBox
            Height="70"
            AcceptsReturn="True"
            PlaceholderText="输入问题或对比主题，例如：这些资料的主要分歧是什么？"
            Text="{Binding ViewModel.QuestionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top" />
          <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="回答会在外部 AI 工具中生成，本应用不内置聊天；问题必填。" />
        </StackPanel>
      </TabItem>

      <TabItem Header="检查维护">
        <StackPanel Margin="12,10,12,10">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="任务" Margin="0,0,8,0" />
            <ComboBox MinWidth="240" MinHeight="32" ItemsSource="{Binding ViewModel.CheckTypes}" SelectedItem="{Binding ViewModel.CheckType, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="检查知识质量：检查来源、矛盾、陈旧、孤立页与缺口。处理已删除资料的引用：先生成清理计划，再在外部确认执行。" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- 双栏：范围/核对 65% · 任务/执行摘要 35% -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="450" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- 左：处理范围或结果核对 -->
      <Border Grid.Column="0" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="18" FontWeight="SemiBold" Text="{Binding ViewModel.ScopePanelTitle}" />
            <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.ScopePanelHint}" />
          </Grid>

          <!-- 准备：待整理变更 -->
          <Grid Grid.Row="1" Visibility="{Binding ViewModel.ShowPendingList, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="128" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="资料名称" />
              <TextBlock Grid.Column="3" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="变化" />
              <TextBlock Grid.Column="4" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="时间" />
            </Grid>
            <ListView
              Grid.Row="1"
              Background="Transparent"
              BorderThickness="0"
              ItemContainerStyle="{StaticResource ProjectListItem}"
              ItemsSource="{Binding ViewModel.PendingRows}"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="44" Margin="2,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <Border Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding TypeBadge}" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="3" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1" CornerRadius="9">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Action}" Value="新增">
                              <Setter Property="Background" Value="{DynamicResource PillSuccessBackgroundBrush}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource PillSuccessBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Action}" Value="修改">
                              <Setter Property="Background" Value="{DynamicResource PillModifyBackgroundBrush}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource PillModifyBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Action}" Value="删除">
                              <Setter Property="Background" Value="{DynamicResource PillDangerBackgroundBrush}" />
                              <Setter Property="BorderBrush" Value="{DynamicResource PillDangerBorderBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Action}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Action}" Value="新增"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                              <DataTrigger Binding="{Binding Action}" Value="修改"><Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" /></DataTrigger>
                              <DataTrigger Binding="{Binding Action}" Value="删除"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Time}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <!-- 准备：所选资料 -->
          <ListView
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource ProjectListItem}"
            ItemsSource="{Binding ViewModel.SourceChoices}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ViewModel.ShowSelectedList, Converter={StaticResource BoolToVis}}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="44" Margin="2,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  <Border Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding TypeBadge}" />
                  </Border>
                  <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MetaText}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <!-- 准备：全部资料 -->
          <StackPanel Grid.Row="1" Visibility="{Binding ViewModel.ShowAllScope, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap">
              <Run Text="全部资料：" />
              <Run FontWeight="SemiBold" Text="{Binding ViewModel.AllSourcesCount, Mode=OneWay}" />
              <Run Text=" 份。按当前规则重新审视全部输入，不会先清空知识目录。" />
            </TextBlock>
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="首次整理或主动全面重整理时使用；生成任务后会冻结本次资料版本。" />
          </StackPanel>

          <!-- 核对：复用同一主表，复选框只表示人工已核对 -->
          <Grid Grid.Row="1" Visibility="{Binding ViewModel.IsReviewMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="资料名称 / 相对路径" />
              <TextBlock Grid.Column="2" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="动作" />
              <TextBlock Grid.Column="3" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="版本状态 / 结论" />
            </Grid>
            <ListView
              Grid.Row="1"
              Background="Transparent"
              BorderThickness="0"
              ItemContainerStyle="{StaticResource ProjectListItem}"
              ItemsSource="{Binding ViewModel.TaskItemRows}"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="44" Margin="2,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="62" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
                    <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Action}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding ReviewText}" TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <!-- 底栏 -->
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Visibility="{Binding ViewModel.IsPreparationMode, Converter={StaticResource BoolToVis}}">
              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.PendingSelectionText}" Visibility="{Binding ViewModel.ShowPendingList, Converter={StaticResource BoolToVis}}" />
              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.SourceSelectionText}" Visibility="{Binding ViewModel.ShowSelectedList, Converter={StaticResource BoolToVis}}" />
              <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="默认不勾选；只清除你核对并确认的项。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="{Binding ViewModel.IsPreparationMode, Converter={StaticResource BoolToVis}}">
              <ui:Button Content="全选" Click="OnSelectAllClick" Margin="0,0,8,0" />
              <ui:Button Content="清空选择" Click="OnClearSelectionClick" />
            </StackPanel>

            <Grid Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewModel.IsReviewMode, Converter={StaticResource BoolToVis}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- “确认已保存，显示待刷新”：确认已持久保存，重试只重载显示、不重复提交确认（03§11 L147） -->
              <StackPanel Grid.Row="0" Visibility="{Binding ViewModel.ConfirmShowStale, Converter={StaticResource BoolToVis}}">
                <ui:InfoBar
                  IsOpen="{Binding ViewModel.ConfirmShowStale, Converter={StaticResource BoolToVis}}"
                  IsClosable="False"
                  Title="确认已保存，显示待刷新"
                  Message="确认结果已持久保存，但页面显示刷新失败。"
                  Severity="Informational" />
                <ui:Button
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0"
                  Content="重试显示"
                  Command="{Binding ViewModel.RetryShowAfterConfirmCommand}" />
              </StackPanel>

              <!-- 本次知识变化：准备以来 wiki 新增/改/删，可能包含其他程序的修改（03§2 知识变化） -->
              <Expander
                Grid.Row="1"
                Margin="0,0,0,6"
                Header="本次知识变化"
                IsExpanded="{Binding ViewModel.HasWikiChanges, Mode=OneWay}">
                <StackPanel>
                  <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.ResultSummary}" TextWrapping="Wrap" />
                  <ListView
                    MaxHeight="150"
                    Margin="0,6,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource ProjectListItem}"
                    ItemsSource="{Binding ViewModel.WikiChanges}">
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="2,3">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Action}" />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Expander>

              <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.TaskPendingCount, StringFormat='待核对 {0} 项'}" />
                <TextBlock Margin="14,0,0,0" Foreground="{DynamicResource WarningBrush}" Text="{Binding ViewModel.TaskChangedCount, StringFormat='有新变化 {0} 项'}" />
              </StackPanel>
              <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Margin="0,0,8,0" PlaceholderText="核对说明（可选，随本次确认保存）" Text="{Binding ViewModel.ConfirmNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button Content="全选可核对项" Command="{Binding ViewModel.SelectAllTaskItemsCommand}" Margin="0,0,8,0" />
                  <ui:Button Content="{Binding ViewModel.ConfirmButtonText}" Appearance="Primary" Command="{Binding ViewModel.ConfirmCommand}" IsEnabled="{Binding ViewModel.CanConfirmSelection}" Margin="0,0,8,0" />
                  <ui:Button Content="结束本任务，剩余继续待整理" Command="{Binding ViewModel.CloseWithRemainingCommand}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="16" HorizontalAlignment="Stretch" Background="Transparent" />

      <!-- 右：本次任务 + 执行摘要 -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="本次任务" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="执行入口" />
                  <ComboBox MinWidth="140" MinHeight="30" ItemsSource="{Binding ViewModel.AgentOptions}" SelectedItem="{Binding ViewModel.SelectedAgentOption, Mode=TwoWay}" ToolTip="本机执行或复制指令" />
                </StackPanel>
              </Grid>

              <!-- 外部执行方式：文件直接访问 / MCP 连接，与执行入口分开（03§2 L17） -->
              <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="外部执行方式" />
                  <ComboBox
                    MinWidth="140"
                    MinHeight="30"
                    ItemsSource="{Binding ViewModel.TransportOptions}"
                    SelectedItem="{Binding ViewModel.Transport, Mode=TwoWay}"
                    ToolTip="外部工具访问知识库的方式：文件直接访问或 MCP 连接" />
                </StackPanel>
                <TextBlock
                  Margin="0,4,0,0"
                  FontSize="{StaticResource FontSizeCaption}"
                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                  Text="{Binding ViewModel.TransportHint}"
                  TextWrapping="Wrap" />
              </StackPanel>

              <!-- 步骤条 -->
              <Grid Margin="0,2,0,12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource StepCircle}" Background="{DynamicResource AccentFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Text="1" />
                  </Border>
                  <Border Grid.Column="1" Height="1" Margin="6,12" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                  <Border Grid.Column="2" Style="{StaticResource StepCircle}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" Text="2" />
                  </Border>
                  <Border Grid.Column="3" Height="1" Margin="6,12" Background="{DynamicResource StrokeBrush}" />
                  <Border Grid.Column="4" Style="{StaticResource StepCircle}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="3" />
                  </Border>
                </Grid>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Width="70" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="准备指令" TextAlignment="Center" />
                  <TextBlock Grid.Column="2" Width="70" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="外部执行" TextAlignment="Center" />
                  <TextBlock Grid.Column="4" Width="70" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="核对结果" TextAlignment="Center" />
                </Grid>
              </Grid>

              <StackPanel Orientation="Horizontal">
                <ui:Button Content="{Binding ViewModel.PrimaryActionText}" Appearance="Primary" Icon="Play24" Command="{Binding ViewModel.PrimaryActionCommand}" IsEnabled="{Binding ViewModel.PrimaryActionEnabled}" Margin="0,0,8,0" />
                <ui:Button Content="复制指令" Icon="Copy24" Command="{Binding ViewModel.CopyTaskCommand}" IsEnabled="{Binding ViewModel.CanCopy}" Visibility="{Binding ViewModel.ShowSecondaryCopy, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                <ui:Button Content="预览完整指令" Command="{Binding ViewModel.PreviewTaskCommand}" IsEnabled="{Binding ViewModel.CanCopy}" />
              </StackPanel>

              <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding ViewModel.TaskStatusText}" TextWrapping="Wrap" />
              <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource WarningBrush}"
                Text="{Binding ViewModel.McpHint}"
                TextWrapping="Wrap" />

              <!-- 运行输出面板：本任务存在 attempt 记录即持久显示（03§5） -->
              <Border
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ViewModel.HasAttemptOutput, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.AgentRunStatus}" TextWrapping="Wrap" />
                  <TextBlock
                    Margin="0,4,0,0"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="较早内容已省略"
                    Visibility="{Binding ViewModel.AgentOutputTruncated, Converter={StaticResource BoolToVis}}" />
                  <TextBox
                    MaxHeight="140"
                    Margin="0,6,0,0"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="{StaticResource FontSizeCaption}"
                    IsReadOnly="True"
                    Text="{Binding ViewModel.AgentOutput}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <ui:Button Content="取消任务" Command="{Binding ViewModel.RequestCancelCommand}" IsEnabled="{Binding ViewModel.IsAgentRunning}" Margin="0,0,8,0" />
                    <ui:Button Content="强制结束本次进程" Click="OnForceKillClick" Visibility="{Binding ViewModel.AgentCanForce, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border
                Margin="0,10,0,0"
                Padding="10,8"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource AccentFillColorTertiaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ViewModel.HasTask, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" Text="本应用无法确认外部 AI 是否完成，请查看结果后再确认处理。" />
                  <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="进程结束或复制成功都不代表全部资料已处理。" />
                </StackPanel>
              </Border>

              <Expander Margin="0,10,0,0" Header="操作指令预览（默认折叠，生成后可展开）" IsExpanded="{Binding ViewModel.ShowPreview}">
                <StackPanel>
                  <TextBox
                    MaxHeight="220"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="{StaticResource FontSizeCaption}"
                    IsReadOnly="True"
                    Text="{Binding ViewModel.TaskInstructionPreview}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                  <ui:Button HorizontalAlignment="Right" Margin="0,6,0,0" Content="收起" Command="{Binding ViewModel.HidePreviewCommand}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- 执行摘要（核对态） -->
          <Border
            Margin="0,10,0,0"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding ViewModel.IsReviewMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="本次执行摘要" />
              <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="以下是任务准备以来检测到的文件变化，可能包含其他程序的修改，不代表均由本次 AI 产生。" />

              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="任务类型" />
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.TaskKindText}" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="范围" />
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.TaskScopeText}" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="访问方式" />
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.TaskTransportText}" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="来源项数" />
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.TaskSourceCount}" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="本机执行" />
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.TaskAttemptText}" TextWrapping="Wrap" />
              </Grid>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="创建时间" />
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.TaskCreatedText}" />
              </Grid>

              <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding ViewModel.LastConfirmMessage}" TextWrapping="Wrap" />
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ui:Button Content="查看本次变化" Command="{Binding ViewModel.ViewChangesCommand}" Margin="0,0,8,0" />
                <ui:Button Content="收起结果" Command="{Binding ViewModel.HideResultCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 未完成任务 -->
          <Expander Margin="0,10,0,0" Header="未完成任务 / 最近任务" IsExpanded="{Binding ViewModel.HasActiveTasks, Mode=OneWay}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding ViewModel.ActiveTasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ProtocolText}" />
                        <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CreatedAt}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding StateText}" />
                        <!-- 03§10 L125：复制路径不再死路，Prepared/Copied 任务可声明已在外部执行并进入核对 -->
                        <ui:Button
                          Content="我已在外部执行，核对结果"
                          Command="{Binding DataContext.ViewModel.MarkExecutedExternallyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          CommandParameter="{Binding}"
                          Visibility="{Binding CanMarkExecutedExternally, Converter={StaticResource BoolToVis}}"
                          Margin="0,0,6,0" />
                        <ui:Button Content="继续核对" Command="{Binding DataContext.ViewModel.LoadTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                        <ui:Button Content="放弃" Command="{Binding DataContext.ViewModel.AbandonTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ViewModel.RecentTasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,2" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                      <Run Text="{Binding ProtocolText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CreatedAt, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
