<Page
  x:Class="LLM_Wiki.Views.Pages.OrganizePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="整理"
  d:DataContext="{d:DesignInstance local:OrganizePage, IsDesignTimeCreatable=False}"
  d:DesignHeight="800"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">
  <Grid Margin="{StaticResource PageContentMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 页头 -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource PageTitleText}" Margin="0" Text="整理" />
        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding ViewModel.SelectedKb, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding ViewModel.PendingSummary, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <ComboBox MinWidth="150" MinHeight="32" ItemsSource="{Binding ViewModel.TransportOptions}" SelectedItem="{Binding ViewModel.Transport, Mode=TwoWay}" ToolTip="执行方式与访问方式分开" />
        <ui:Button Content="刷新待整理清单" Icon="ArrowSync24" Command="{Binding ViewModel.RefreshPendingCommand}" Margin="8,0,0,0" />
        <ui:Button Content="更多 ▾" Click="OnMoreClick" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <!-- 规则更新提醒（长期状态，不用 Toast） -->
    <Border
      Grid.Row="1"
      Margin="0,0,0,10"
      Padding="12"
      CornerRadius="8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource WarningBrush}"
      BorderThickness="1"
      Visibility="{Binding ViewModel.RuleNeedsReview, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Text="规则已更新，已有知识尚未按新规则核对。旧指令不能当作当前指令复制；任务核对完成后请显式确认。" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button Content="稍后处理" Click="OnIgnoreRulesClick" Margin="0,0,8,0" />
          <ui:Button Content="确认已按新规则核对" Click="OnAcknowledgeRulesClick" Appearance="Primary" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 三类任务 -->
    <TabControl Grid.Row="2" SelectedIndex="{Binding ViewModel.ActiveTab, Mode=TwoWay}" Margin="0,0,0,10">
      <TabItem Header="更新知识">
        <StackPanel Margin="12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="处理范围" Margin="0,0,8,0" />
            <ComboBox MinWidth="180" MinHeight="32" ItemsSource="{Binding ViewModel.ScopeOptions}" SelectedItem="{Binding ViewModel.Scope, Mode=TwoWay}" />
          </StackPanel>

          <!-- 待整理变更 -->
          <StackPanel Visibility="{Binding ViewModel.IsScopePending, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <ui:Button Content="全选" Click="OnSelectAllPendingClick" Margin="0,0,8,0" />
              <ui:Button Content="清空选择" Click="OnClearPendingClick" />
            </StackPanel>
            <ListView MaxHeight="220" ItemsSource="{Binding ViewModel.PendingRows}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,4" Width="820">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Action}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding Time}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="默认不勾选；只清除你核对并确认的项。" />
          </StackPanel>

          <!-- 所选资料 -->
          <StackPanel Visibility="{Binding ViewModel.IsScopeSelected, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <ui:Button Content="全选" Click="OnSelectAllSourcesClick" Margin="0,0,8,0" />
              <ui:Button Content="清空选择" Click="OnClearSourcesClick" />
            </StackPanel>
            <ListView MaxHeight="220" ItemsSource="{Binding ViewModel.SourceChoices}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,4" Width="820">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding MetaText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="从资料页“整理所选”进入时会自动带入选择；也可在此手动勾选。" />
          </StackPanel>

          <!-- 全部资料 -->
          <StackPanel Visibility="{Binding ViewModel.IsScopeAll, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap">
              <Run Text="全部资料：" />
              <Run Text="{Binding ViewModel.AllSourcesCount, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text=" 份。按当前规则重新审视全部输入，不会先清空知识目录。" />
            </TextBlock>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="首次整理或主动全面重整理时使用；可能耗时较长。生成任务后会冻结本次资料版本。" />
          </StackPanel>

          <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.TransportHint}" TextWrapping="Wrap" />
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}" Text="{Binding ViewModel.McpHint}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="提问分析">
        <StackPanel Margin="12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="类型" Margin="0,0,8,0" />
            <ComboBox MinWidth="160" MinHeight="32" ItemsSource="{Binding ViewModel.AskTypes}" SelectedItem="{Binding ViewModel.AskType, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Margin="0,0,0,6" Text="你想了解什么？回答会在外部 AI 工具中生成，本应用不内置聊天。" TextWrapping="Wrap" />
          <ui:TextBox
            Height="80"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top"
            PlaceholderText="输入问题或对比主题，例如：这些资料的主要分歧是什么？"
            Text="{Binding ViewModel.QuestionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.TransportHint}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="检查维护">
        <StackPanel Margin="12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="任务" Margin="0,0,8,0" />
            <ComboBox MinWidth="240" MinHeight="32" ItemsSource="{Binding ViewModel.CheckTypes}" SelectedItem="{Binding ViewModel.CheckType, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="检查知识质量：检查来源、矛盾、陈旧、孤立页与缺口，报告后仍由你核对。" />
          </TextBlock>
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="处理已删除资料的引用：先生成清理计划，再在外部确认执行；不提供“一键清空知识”。" />
          </TextBlock>
          <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.TransportHint}" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- 共享任务动作 / 状态 / 结果 -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}" BorderThickness="1">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:Button
                Content="{Binding ViewModel.CopyButtonText}"
                Appearance="Primary"
                Icon="Copy24"
                Command="{Binding ViewModel.CopyTaskCommand}"
                IsEnabled="{Binding ViewModel.CanCopy}"
                Margin="0,0,8,0" />
              <ui:Button Content="预览完整指令" Command="{Binding ViewModel.PreviewTaskCommand}" IsEnabled="{Binding ViewModel.CanCopy}" Margin="0,0,8,0" />
              <ui:Button Content="查看本次变化" Command="{Binding ViewModel.ViewChangesCommand}" IsEnabled="{Binding ViewModel.HasTask}" />
              <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="复制不等于执行完成；外部执行后请核对结果再确认。" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding ViewModel.TaskStatusText}" TextWrapping="Wrap" />

            <Expander Margin="0,10,0,0" Header="指令预览（默认折叠，生成后可展开）" IsExpanded="{Binding ViewModel.ShowPreview}">
              <StackPanel>
                <TextBox
                  MaxHeight="260"
                  IsReadOnly="True"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                  FontFamily="Consolas"
                  FontSize="{StaticResource FontSizeCaption}"
                  Text="{Binding ViewModel.TaskInstructionPreview}" />
                <ui:Button HorizontalAlignment="Right" Margin="0,6,0,0" Content="收起" Command="{Binding ViewModel.HidePreviewCommand}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <!-- 结果核对 -->
        <Border
          Margin="0,10,0,0"
          Padding="14"
          CornerRadius="10"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1"
          Visibility="{Binding ViewModel.ShowResult, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="本次结果核对" />
            <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="以下是任务准备以来检测到的文件变化，可能包含其他程序的修改，不代表均由本次 AI 产生。" />

            <TextBlock FontWeight="SemiBold" Text="知识文件变化" Margin="0,4,0,4" />
            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.ResultSummary}" TextWrapping="Wrap" />
            <ListView MaxHeight="140" ItemsSource="{Binding ViewModel.WikiChanges}" Background="Transparent" BorderThickness="0" Margin="0,6,0,8">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,3" Width="820">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <TextBlock FontWeight="SemiBold" Text="资料逐项核对" Margin="0,4,0,4" />
            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="勾选你已核对完成的资料；未读取、失败或未完整读取的项目默认保留。没有对应待整理记录的文件不会清除任何变更。" />
            <ListView MaxHeight="200" ItemsSource="{Binding ViewModel.TaskItemRows}" Background="Transparent" BorderThickness="0" Margin="0,6,0,6">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,4" Width="820">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Action}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
              <ui:Button Content="全选可核对项" Command="{Binding ViewModel.SelectAllTaskItemsCommand}" Margin="0,0,8,0" />
              <ui:TextBox Width="360" PlaceholderText="补充说明（可选，例如：已在其他工具完成）" Text="{Binding ViewModel.ConfirmNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="只移出所选且仍匹配的待整理记录，不会修改源文件和知识。" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <ui:Button Content="确认完成所选项" Appearance="Primary" Command="{Binding ViewModel.ConfirmCommand}" IsEnabled="{Binding ViewModel.HasTask}" Margin="0,0,8,0" />
              <ui:Button Content="收起结果" Command="{Binding ViewModel.HideResultCommand}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="{Binding ViewModel.LastConfirmMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 未完成任务 / 最近任务 -->
        <Expander Margin="0,10,0,0" Header="未完成任务 / 最近任务" IsExpanded="{Binding ViewModel.HasActiveTasks, Mode=OneWay}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding ViewModel.ActiveTasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4" Width="900">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding ProtocolText}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding CreatedAt}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding StateText}" Foreground="{DynamicResource AccentLightBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <ui:Button Content="继续核对" Command="{Binding DataContext.ViewModel.LoadTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="0,0,8,0" />
                      <ui:Button Content="放弃" Command="{Binding DataContext.ViewModel.AbandonTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ViewModel.RecentTasks}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="{Binding ProtocolText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CreatedAt, Mode=OneWay}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
