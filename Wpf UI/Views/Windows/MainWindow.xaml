<ui:FluentWindow
  x:Class="LLM_Wiki.Views.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Windows"
  xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
  xmlns:controls="clr-namespace:LLM_Wiki.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
  FontFamily="Microsoft YaHei UI, Segoe UI"
  FontSize="14"
  Width="1440"
  Height="900"
  MinWidth="1100"
  MinHeight="650"
  d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=True}"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 标题/搜索一行 52（00§6：不叠两条标题栏）：库切换器、查找并入 TitleBar.Header，帮助在右侧 -->
    <ui:TitleBar
      x:Name="TitleBar"
      Grid.Row="0"
      Height="52"
      Background="{DynamicResource NavigationBackgroundBrush}"
      Title=""
      CloseWindowByDoubleClickOnIcon="True">
      <ui:TitleBar.Header>
        <Grid VerticalAlignment="Center" Width="{Binding ActualWidth, ElementName=TitleBar}" MaxWidth="1100">
          <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="192" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ui:SymbolIcon Symbol="BookOpen24" FontSize="28" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Left" Margin="8,0,0,0" />
          <TextBlock
            Margin="48,0,0,0"
            VerticalAlignment="Center"
            FontSize="18"
            FontWeight="SemiBold"
            Text="{Binding ViewModel.ApplicationTitle}" />
          <Button
            x:Name="KbPickerButton" Grid.Column="1" HorizontalAlignment="Left"
            Margin="16,0,0,0"
            MinHeight="32"
            Padding="12,4"
            Background="Transparent"
            BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
            BorderThickness="1"
            Click="OnKbPickerClick"
            ToolTip="切换或新建知识库">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Library24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                MaxWidth="240"
                TextTrimming="CharacterEllipsis"
                Text="{Binding ViewModel.KbPickerText}" />
              <TextBlock Text=" ▾" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Button>

          <ui:TextBox
            x:Name="TopSearchBox" Grid.Column="2"
            Margin="48,0,24,0" MinWidth="220"
            VerticalAlignment="Center"
            PlaceholderText="查找当前库文件…（Ctrl+K）"
            Icon="Search24"
            KeyDown="OnTopSearchKeyDown"
            TextChanged="OnTopSearchTextChanged" />
        </Grid>
      </ui:TitleBar.Header>
      <ui:TitleBar.TrailingContent>
        <StackPanel Orientation="Horizontal">
          <ui:Button
            x:Name="NotifyBell"
            Margin="0,0,8,0"
            Appearance="Transparent"
            Click="OnNotifyBellClick"
            ToolTip="通知中心">
            <Grid>
              <ui:SymbolIcon Symbol="Alert24" FontSize="18" />
              <Border
                x:Name="NotifyBadge"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                MinWidth="16" Height="16" CornerRadius="8"
                Background="{DynamicResource SystemFillColorCriticalBrush}"
                Visibility="Collapsed">
                <TextBlock x:Name="NotifyBadgeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="White" />
              </Border>
            </Grid>
          </ui:Button>
          <ui:Button
            Margin="0,0,8,0"
            Content="帮助"
            Icon="QuestionCircle24"
            Click="OnHelpClick"
            Appearance="Secondary"
            ToolTip="使用帮助" />
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
      FrameMargin="0"
      TransitionDuration="0"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleVisible="False"
      MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
      OpenPaneLength="208"
      CompactPaneLength="64"
      Navigating="OnRootNavigating"
      PaneDisplayMode="Left">
      <ui:NavigationView.ContentOverlay>
        <Grid>
          <controls:CompactSnackbarPresenter x:Name="SnackbarPresenter" Width="420" MaxWidth="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,16" />
        </Grid>
      </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>

    <!-- 底部状态栏 -->
    <Border
      Grid.Row="2"
      MinHeight="28"
      Padding="20,2"
      Background="{DynamicResource NavigationBackgroundBrush}"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Column="0" Content="目录不可访问 · 修复存储路径" Click="OnFixStorageClick" Appearance="Transparent" ToolTip="{Binding ViewModel.StorageError}" Visibility="{Binding ViewModel.HasStorageError, Converter={StaticResource BoolToVis}}" />
        <TextBlock Visibility="{Binding ViewModel.HasStorageError, Converter={StaticResource InvBoolToVis}}" Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding ViewModel.StorageError}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="{Binding ViewModel.CurrentKb, Mode=OneWay, FallbackValue='未选择'}" />
          <Run Text=" · " /><Run Text="{Binding ViewModel.StatusDirectory, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="{Binding ViewModel.StatusPending, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="{Binding ViewModel.StatusShare, Mode=OneWay}" />
        </TextBlock>
        <!-- 本机任务入口：可点，跳转整理页任务（00§6 状态栏） -->
        <ui:Button
          Grid.Column="3"
          Margin="20,0,0,0"
          Padding="4,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Appearance="Transparent"
          Content="{Binding ViewModel.StatusAi, Mode=OneWay}"
          Click="OnStatusTaskClick"
          ToolTip="查看本机任务（整理页）" />
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
      </Grid>
    </Border>

    <!-- 全局查找覆盖层：只查当前库文件名 -->
    <Grid Grid.Row="0" Grid.RowSpan="3"
          Background="{DynamicResource OverlayBrush}"
          Visibility="{Binding ViewModel.IsSearchOpen, Converter={StaticResource BoolToVis}}">
      <Border
        Width="680"
        MaxHeight="560"
        VerticalAlignment="Top"
        Margin="0,120,0,0"
        Padding="20"
        CornerRadius="12"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
        BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="查找当前库文件" />
          <ui:TextBox
            x:Name="SearchOverlayBox"
            Grid.Row="1"
            Margin="0,12,0,8"
            PlaceholderText="输入文件名片段，只查找文件名，不检索正文"
            Icon="Search24"
            Text="{Binding ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="OnSearchOverlayKeyDown" />
          <ListView
            x:Name="SearchResultList"
            Grid.Row="2"
            MaxHeight="380"
            ItemsSource="{Binding ViewModel.SearchResults, Mode=OneWay}"
            MouseDoubleClick="OnSearchResultDoubleClick"
            Background="Transparent"
            BorderThickness="0">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="16" Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RelPath}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GroupText}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.SearchStatus}" />
            <ui:Button HorizontalAlignment="Right" Content="关闭 (Esc)" Click="OnCloseSearchClick" Appearance="Secondary" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="4" />

    <!-- 通知中心面板：右上角铃铛下拉，近 3 天消息，按时间倒序 -->
    <Popup
      x:Name="NotifyPopup"
      PlacementTarget="{Binding ElementName=NotifyBell}"
      Placement="Bottom"
      StaysOpen="False"
      AllowsTransparency="True"
      PopupAnimation="Fade">
      <Border
        Width="400" MaxHeight="480"
        Margin="8"
        Padding="12"
        CornerRadius="10"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
        BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="通知中心（近 3 天）" />
            <ui:Button HorizontalAlignment="Right" Content="全部已读" Appearance="Transparent" Click="OnNotifyMarkAllReadClick" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock x:Name="NotifyEmptyHint" Margin="0,16" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="暂无通知" Visibility="Collapsed" />
              <ItemsControl x:Name="NotifyList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Margin="0,0,0,6" Padding="10,8"
                      CornerRadius="6"
                      Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
                      BorderThickness="1">
                      <StackPanel>
                        <Grid>
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                              <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                  <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="success">
                                      <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="warning">
                                      <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="error">
                                      <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="未读">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Time, StringFormat='MM-dd HH:mm:ss'}" />
                        </Grid>
                        <TextBlock Margin="14,3,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Popup>

    <!--
      系统托盘：XAML 声明可让右键菜单继承 WPF-UI 的 ContextMenu/MenuItem 样式，
      深浅色跟随 Application.Resources 的主题字典切换；图标与 exe/桌面快捷方式同源。
    -->
    <tb:TaskbarIcon
      x:Name="TrayIcon"
      Grid.Row="0"
      Grid.RowSpan="4"
      IconSource="pack://application:,,,/Assets/wpfui-icon-256.png"
      NoLeftClickDelay="True"
      ToolTipText="LLM Wiki"
      TrayLeftMouseDoubleClick="OnTrayDoubleClick">
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Click="OnTrayOpen" Header="打开 LLM Wiki" />
          <Separator />
          <MenuItem Click="OnTrayExit" Header="退出" />
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
  </Grid>
</ui:FluentWindow>
