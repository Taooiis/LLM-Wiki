<ui:FluentWindow
  x:Class="LLM_Wiki.Views.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:LLM_Wiki.Views.Windows"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
  Width="1440"
  Height="900"
  MinWidth="1180"
  MinHeight="760"
  d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=True}"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      x:Name="TitleBar"
      Grid.Row="0"
      Title="{Binding ViewModel.ApplicationTitle}"
      CloseWindowByDoubleClickOnIcon="True" />

    <!-- 顶栏：库切换器 + 当前库文件名查找 + 帮助 -->
    <Border
      Grid.Row="1"
      Padding="20,8,20,8"
      Background="{DynamicResource NavigationBackgroundBrush}"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,0,0,1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
          x:Name="KbPickerButton"
          Grid.Column="0"
          MinHeight="32"
          Padding="12,4"
          Background="Transparent"
          BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
          BorderThickness="1"
          Click="OnKbPickerClick"
          ToolTip="切换或新建知识库">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Library24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              MaxWidth="240"
              TextTrimming="CharacterEllipsis"
              Text="{Binding ViewModel.KbPickerText}" />
            <TextBlock Text=" ▾" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Button>

        <TextBlock
          Grid.Column="1"
          Margin="16,0,12,0"
          VerticalAlignment="Center"
          FontSize="{StaticResource FontSizeCaption}"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          Text="当前库" />

        <ui:TextBox
          x:Name="TopSearchBox"
          Grid.Column="2"
          Width="380"
          HorizontalAlignment="Left"
          PlaceholderText="查找当前库文件…（Ctrl+K）"
          Icon="Search24"
          KeyDown="OnTopSearchKeyDown"
          TextChanged="OnTopSearchTextChanged" />

        <ui:Button
          Grid.Column="3"
          Content="帮助"
          Icon="QuestionCircle24"
          Click="OnHelpClick"
          Appearance="Secondary"
          ToolTip="使用帮助" />

        <Border
          Grid.Row="1"
          Grid.ColumnSpan="4"
          Margin="0,8,0,0"
          Padding="10,6"
          CornerRadius="6"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource DangerBrush}"
          BorderThickness="1"
          Visibility="{Binding ViewModel.HasStorageError, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding ViewModel.StorageError}" />
            <ui:Button Grid.Column="1" Content="修复存储路径" Click="OnFixStorageClick" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="2"
      FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
      FrameMargin="0"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleVisible="True"
      MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
      OpenPaneLength="208"
      PaneDisplayMode="Left">
      <ui:NavigationView.ContentOverlay>
        <Grid>
          <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
        </Grid>
      </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>

    <!-- 底部状态栏 -->
    <Border
      Grid.Row="3"
      Padding="20,4"
      Background="{DynamicResource NavigationBackgroundBrush}"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="{Binding ViewModel.CurrentKb, Mode=OneWay, FallbackValue='未选择'}" />
          <Run Text=" · " /><Run Text="{Binding ViewModel.StatusDirectory, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="{Binding ViewModel.StatusPending, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="{Binding ViewModel.StatusShare, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="3" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Run Text="{Binding ViewModel.StatusAi, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
      </Grid>
    </Border>

    <!-- 全局查找覆盖层：只查当前库文件名 -->
    <Grid Grid.Row="0" Grid.RowSpan="4"
          Background="#99000000"
          Visibility="{Binding ViewModel.IsSearchOpen, Converter={StaticResource BoolToVis}}">
      <Border
        Width="680"
        MaxHeight="560"
        VerticalAlignment="Top"
        Margin="0,120,0,0"
        Padding="20"
        CornerRadius="12"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
        BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="查找当前库文件" />
          <ui:TextBox
            x:Name="SearchOverlayBox"
            Grid.Row="1"
            Margin="0,12,0,8"
            PlaceholderText="输入文件名片段，只查找文件名，不检索正文"
            Icon="Search24"
            Text="{Binding ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="OnSearchOverlayKeyDown" />
          <ListView
            x:Name="SearchResultList"
            Grid.Row="2"
            MaxHeight="380"
            ItemsSource="{Binding ViewModel.SearchResults, Mode=OneWay}"
            MouseDoubleClick="OnSearchResultDoubleClick"
            Background="Transparent"
            BorderThickness="0">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="16" Margin="0,0,10,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RelPath}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GroupText}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewModel.SearchStatus}" />
            <ui:Button HorizontalAlignment="Right" Content="关闭 (Esc)" Click="OnCloseSearchClick" Appearance="Secondary" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="0" Grid.RowSpan="4" />
  </Grid>
</ui:FluentWindow>
