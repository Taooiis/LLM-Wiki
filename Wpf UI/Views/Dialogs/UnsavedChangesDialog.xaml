<ui:ContentDialog
  x:Class="LLM_Wiki.Views.Dialogs.UnsavedChangesDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="还有未保存的更改"
  PrimaryButtonText="保存并继续"
  SecondaryButtonText="放弃更改"
  CloseButtonText="留在此处"
  DefaultButton="Close"
  PrimaryButtonAppearance="Primary"
  Style="{StaticResource {x:Type ui:ContentDialog}}"
  mc:Ignorable="d"
  d:DesignHeight="240"
  d:DesignWidth="520">
  <!--
    D02 未保存离开（00§9.4）：三按钮从左到右 放弃更改→留在此处→保存并继续，初焦“留在此处”。
    槽位映射（App.xaml 项目模板已重排视觉次序）：Secondary=放弃更改，Close=留在此处（Esc 等价），Primary=保存并继续。
  -->
  <StackPanel Margin="0,8,0,4" MaxWidth="460">
    <TextBlock
      x:Name="LeadTextBlock"
      Text="离开前，请处理以下文件的修改。"
      FontSize="{StaticResource FontSizeBody}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextWrapping="Wrap" />
    <TextBlock
      x:Name="FilesText"
      Margin="0,10,0,0"
      FontSize="13"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      TextWrapping="Wrap" />
    <TextBlock
      Margin="0,8,0,0"
      FontSize="{StaticResource FontSizeCaption}"
      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
      TextWrapping="Wrap"
      Text="放弃更改只丢弃本次未保存的缓冲，不影响已写入磁盘的内容。" />
  </StackPanel>
</ui:ContentDialog>
