<UserControl
  x:Class="LLM_Wiki.Controls.DocumentWorkspace"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:LLM_Wiki.Controls"
  mc:Ignorable="d"
  d:DesignHeight="520"
  d:DesignWidth="640">
  <!-- 文档工作区（指南 §6）：Empty / Preview / Editing / ReadOnly 四态 -->
  <Border Style="{StaticResource CardBorder}" Padding="0">
    <Grid>
      <!-- ============ Empty 态 ============ -->
      <controls:EmptyState
        Icon="📄"
        Title="选择一个文件查看内容"
        Description="从左侧选择文件，或新建 / 上传文件">
        <controls:EmptyState.Style>
          <Style TargetType="controls:EmptyState">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Mode}" Value="Empty">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </controls:EmptyState.Style>
      </controls:EmptyState>

      <!-- ============ Preview / Editing / ReadOnly 共用框架 ============ -->
      <Grid Visibility="{Binding WorkspaceFrameVisibility}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶行：文件名 + 保存状态（常驻可见，指南 §1.4） -->
        <Grid Grid.Row="0" Margin="16,14,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentFileName}" TextTrimming="CharacterEllipsis" />
            <TextBlock
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              FontSize="{StaticResource FontSizeCaption}"
              FontWeight="SemiBold"
              Text="{Binding SaveStateText}"
              Foreground="{Binding SaveStateBrush}" />
          </StackPanel>
          <!-- 状态操作：预览态的编辑/打开；编辑态无 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button
              Content="编辑"
              Command="{Binding EnterEditModeCommand}"
              Visibility="{Binding IsPreviewEditable}"
              Margin="0,0,8,0"
              Appearance="Primary"
              Icon="Edit24" />
            <ui:Button
              Content="打开"
              Command="{Binding OpenWithDefaultProgramCommand}"
              Visibility="{Binding IsReadOnlyMode}"
              Appearance="Secondary"
              Icon="Open24" />
          </StackPanel>
        </Grid>

        <!-- 次行：相对路径面包屑（只读定位） -->
        <TextBlock
          Grid.Row="1"
          Margin="16,4,16,10"
          FontSize="{StaticResource FontSizeCaption}"
          FontFamily="Consolas"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          TextTrimming="CharacterEllipsis"
          Text="{Binding PathBreadcrumb}" />

        <!-- 新建：文件名输入（指南 §6.4） -->
        <StackPanel
          Grid.Row="1"
          Margin="16,4,16,10"
          Orientation="Horizontal"
          Visibility="{Binding IsNewDocumentVisible}">
          <TextBlock VerticalAlignment="Center" Text="文件名：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ui:TextBox
            Width="280"
            Margin="8,0,0,0"
            PlaceholderText="输入文件名（自动补 .md）"
            Text="{Binding NewFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 内容区：预览（只读展示） / 编辑（可写） -->
        <Grid Grid.Row="2" Margin="16,0,16,0">
          <TextBox
            Background="Transparent"
            BorderThickness="0"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding PreviewContent, Mode=OneWay}"
            Visibility="{Binding IsPreviewContentVisible}" />
          <TextBox
            x:Name="EditorBox"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            VerticalContentAlignment="Top"
            FontFamily="Consolas"
            FontSize="{StaticResource FontSizeBody}"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource StrokeFillColorDefaultBrush}"
            BorderThickness="1"
            Padding="10"
            Text="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{Binding IsEditingContentVisible}"
            KeyDown="EditorBox_KeyDown" />
        </Grid>

        <!-- 底部状态区：编码/类型/错误 + 取消/保存（指南 §6.3） -->
        <Grid Grid.Row="3" Margin="16,10,16,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
              <Run Text="UTF-8" /><Run Text=" · " /><Run Text="{Binding FileTypeLabel, Mode=OneWay}" />
            </TextBlock>
            <TextBlock
              FontSize="{StaticResource FontSizeCaption}"
              Foreground="{DynamicResource SystemFillColorDangerBrush}"
              TextWrapping="Wrap"
              Margin="0,4,0,0"
              Text="{Binding SaveErrorMessage}"
              Visibility="{Binding HasSaveError}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button
              Content="取消"
              Command="{Binding CancelEditCommand}"
              Margin="0,0,8,0"
              Visibility="{Binding IsEditingContentVisible}" />
            <ui:Button
              Content="保存  (Ctrl+S)"
              Appearance="Primary"
              Command="{Binding SaveCommand}"
              Visibility="{Binding IsEditingContentVisible}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
