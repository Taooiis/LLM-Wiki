<Application
  x:Class="LLM_Wiki.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=mscorlib"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  DispatcherUnhandledException="OnDispatcherUnhandledException"
  Exit="OnExit"
  Startup="OnStartup"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <!-- 全局字号档位：所有页面统一引用，禁止页面内魔数字号 -->
      <sys:Double x:Key="FontSizePageTitle">28</sys:Double>
      <sys:Double x:Key="FontSizeSectionTitle">18</sys:Double>
      <sys:Double x:Key="FontSizeBody">14</sys:Double>
      <sys:Double x:Key="FontSizeCaption">12</sys:Double>

      <!-- 页面标题：每页顶部唯一大标题 -->
      <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,0,0,16" />
      </Style>

      <!-- 区块标题：卡片/分组标题 -->
      <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>

      <!-- 页面内容统一留白节奏 -->
      <Thickness x:Key="PageContentMargin">24,16,24,24</Thickness>
    </ResourceDictionary>
  </Application.Resources>
</Application>
