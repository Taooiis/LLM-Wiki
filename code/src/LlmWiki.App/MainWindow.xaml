<Window x:Class="LlmWiki.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Wiki 知识库" Height="800" Width="1200">
    <Grid>
        <!-- WebView2 控件：承载维护面板（wwwroot/index.html） -->
        <Wpf:WebView2 x:Name="BridgeWebView"
                      xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" />

        <!-- 拖拽提示层：文件拖进窗口时显示；不拦截鼠标，避免影响页面交互 -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#B31E293B" Margin="16" CornerRadius="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="松手即上传" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="DropOverlayHint" Foreground="#CBD5E1" FontSize="13"
                           Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
