<Window x:Class="LlmWiki.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LLM Wiki 知识库" Height="800" Width="1200"
        WindowState="Maximized"
        Background="#FBFCFE"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbRefresh" Description="刷新" Click="OnThumbRefresh"/>
                <ThumbButtonInfo x:Name="ThumbShareToggle" Description="切换分享" Click="OnThumbShareToggle"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2F343B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F6F8FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_文件(_F)">
                <MenuItem Header="打开文件夹(_O)" Click="OnOpenFolder"/>
                <MenuItem Header="打开文件(_T)" Click="OnOpenFile"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_编辑(_E)">
                <MenuItem Header="剪切(_X)" Click="OnCut"/>
                <MenuItem Header="复制(_C)" Click="OnCopy"/>
                <MenuItem Header="粘贴(_V)" Click="OnPaste"/>
            </MenuItem>
            <MenuItem Header="_视图(_V)">
                <MenuItem Header="刷新(_R)" Click="OnRefresh"/>
            </MenuItem>
            <MenuItem Header="_帮助(_H)">
                <MenuItem Header="关于(_A)" Click="OnAbout"/>
            </MenuItem>
            <MenuItem Header="_设置(_S)">
                <MenuItem Header="设置(_T)" Click="OnSettings"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Margin="4,2,0,2">
            <Button Click="OnRefresh" ToolTip="刷新" Content="🔄 刷新"/>
            <Button Click="OnShareToggle" ToolTip="分享" Content="📡 分享"/>
            <Separator/>
            <TextBox x:Name="SearchBox" Width="180" ToolTip="搜索"/>
            <Button Content="🔍 搜索" Click="OnSearch" ToolTip="搜索"/>
        </ToolBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Row="0" Grid.Column="0" Background="#FBFCFE" BorderThickness="0,0,1,0" BorderBrush="#E1E4E8">
                <StackPanel>
                    <!-- 知识库选择 -->
                    <TextBlock Text="知识库" FontWeight="SemiBold" Foreground="#575C65" Margin="12,8,12,4" FontSize="12"/>
                    <ComboBox x:Name="KbSelector" Height="28" Margin="12,0,12,12" BorderBrush="#D1D5DB"/>

                    <!-- 目录树 -->
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="目录树" FontWeight="SemiBold" Foreground="#575C65" Margin="12,12,12,4" FontSize="12"/>
                            <TreeView x:Name="DirTree" Height="400" Margin="0,0,12,12">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="#2F343B"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="IsExpanded" Value="True"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E8EDF2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 快速操作 -->
                    <TextBlock Text="快速操作" FontWeight="SemiBold" Foreground="#575C65" Margin="12,4,12,4" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="12,0,12,12">
                        <Button Click="OnThemeToggle" Width="40" Height="28" Content="☀️"/>
                        <Button Click="OnRefresh" Width="40" Height="28" Margin="4,0,0,0" Content="🔄"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 右侧 WebView2 内容区 -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Wpf:WebView2 x:Name="BridgeWebView" Grid.Row="0"/>

                <!-- 状态栏 -->
                <StatusBar Grid.Row="1" Background="#F5F7FA" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
                    <StatusBarItem>
                        <TextBlock Text="知识库: " Foreground="#575C65" FontWeight="SemiBold" Margin="0,0,4,0"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusKb" Foreground="#2F343B"/>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem>
                        <TextBlock Text="文件数: " Foreground="#575C65" FontWeight="SemiBold" Margin="0,0,4,0"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusFileCount" Foreground="#2F343B"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="StatusShare" Foreground="#575C65" Visibility="Collapsed">📡 已分享</TextBlock>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem HorizontalAlignment="Right">
                        <TextBlock Text=" v1.0" Foreground="#8A95A8"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>

        <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#B31E293B" Margin="16" CornerRadius="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="松手即上传" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropOverlayHint" Foreground="#CBD5E1" FontSize="13"
                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>