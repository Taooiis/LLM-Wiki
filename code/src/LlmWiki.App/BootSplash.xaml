<Window x:Class="LlmWiki.App.BootSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#2F343B"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo / 品牌 -->
        <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- LLM Wiki 文本 Logo -->
                <TextBlock Text="LLM" FontSize="32" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Wiki" FontSize="28" Foreground="#E8EDF2" 
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="知识库管理" FontSize="12" Foreground="#8A95A8" 
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- 底部状态 -->
        <TextBlock Grid.Row="1" Text="加载中..." FontSize="12" Foreground="#8A95A8"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
    </Grid>
</Window>